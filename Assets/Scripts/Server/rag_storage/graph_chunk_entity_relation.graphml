  <data key="d10">unknown_source</data>
  <data key="d11">1749741039</data>
</edge>
<edge source="Giấy chứng nhận quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất" target="Tòa án">
  <data key="d6">10.0</data>
  <data key="d7">Tòa án có thẩm quyền ban hành bản án hoặc quyết định liên quan đến quyền sở hữu nhà ở và cấp Giấy chứng nhận quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất.</data>
