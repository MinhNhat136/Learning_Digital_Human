</edge>
<edge source="Thửa đất" target="Sử dụng đất ổn định">
  <data key="d6">7.0</data>
  <data key="d7">Sử dụng đất ổn định liên quan đến việc sử dụng thửa đất vào một mục đích chính nhất định.</data>
