</edge>
<edge source="Chính phủ" target="Ủy ban nhân dân cấp huyện">
  <data key="d6">9.0</data>
  <data key="d7">Chính phủ regulates and oversees the land requisition and demolition operations carried out by Ủy ban nhân dân cấp huyện.</data>
