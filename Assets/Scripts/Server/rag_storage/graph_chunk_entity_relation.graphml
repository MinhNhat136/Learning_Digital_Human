</edge>
<edge source="Quỹ đất ở" target="Quỹ nhà tái định cư">
  <data key="d6">9.0</data>
  <data key="d7">Quỹ đất ở và quỹ nhà tái định cư có mối quan hệ trong việc cung cấp đất và nhà cho những người có đất thu hồi.</data>
  <data key="d8">nhà,đất</data>
  <data key="d9">chunk-9a88f9e82e87dae6ff3459ac963afcac</data>
  <data key="d10">unknown_source</data>
