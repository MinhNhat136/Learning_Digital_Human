  <data key="d4">unknown_source</data>
  <data key="d5">1749739150</data>
</node>
<node id="Điều 119">
  <data key="d0">Điều 119</data>
  <data key="d1">category</data>
  <data key="d2">Điều 119 là điều khoản trong Luật này quy định về giao đất có thu tiền sử dụng đất.&lt;SEP&gt;Điều 119 là điều khoản trong Luật này quy định về việc cho thuê đất.&lt;SEP&gt;Điều 119 refers to a specific article or provision in the law that outlines the rules for land use by organizations for infrastructure development.&lt;SEP&gt;Điều 119 là điều khoản trong Luật đất đai quy định về việc giao đất không thu tiền sử dụng đất.</data>
  <data key="d3">chunk-9ef14cf646536c5238297bafec2f030b&lt;SEP&gt;chunk-3fd9b376c1da4a3363e3db9b92809484&lt;SEP&gt;chunk-eb8c4697d8f9c79d651403238c3f5640&lt;SEP&gt;chunk-e95fa72656913e44897b9372de39ee00</data>
