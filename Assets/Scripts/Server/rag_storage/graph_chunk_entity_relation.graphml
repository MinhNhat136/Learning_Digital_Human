  <data key="d11">1749740523</data>
</edge>
<edge source="Tổ chức kinh tế" target="Chuyển nhượng quyền sử dụng đất">
  <data key="d6">6.0</data>
  <data key="d7">Tổ chức kinh tế có thể nhận chuyển nhượng quyền sử dụng đất, nhưng có những hạn chế nhất định.</data>
  <data key="d8">hạn chế,quyền sử dụng đất</data>
