</edge>
<edge source="Hộ nghèo" target="Hộ cận nghèo">
  <data key="d6">6.0</data>
  <data key="d7">Hộ nghèo và hộ cận nghèo đều được hỗ trợ về đất đai theo chính sách của Nhà nước.</data>
  <data key="d8">bảo vệ quyền lợi,hỗ trợ</data>
