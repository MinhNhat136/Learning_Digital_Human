  <data key="d11">1749780600</data>
</edge>
<edge source="Cá nhân" target="Tiền thuê đất">
  <data key="d6">7.0</data>
  <data key="d7">Cá nhân phải trả tiền thuê đất cho Nhà nước khi được cho thuê đất.</data>
  <data key="d8">sử dụng đất,trả phí</data>
