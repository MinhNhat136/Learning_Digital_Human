<edge source="Đất có mặt nước chuyên dùng" target="Đất rừng đặc dụng, đất rừng phòng hộ, đất rừng sản xuất">
  <data key="d6">7.0</data>
  <data key="d7">Đất rừng đặc dụng, đất rừng phòng hộ, đất rừng sản xuất và đất có mặt nước chuyên dùng đều là đất sử dụng vào mục đích bảo vệ môi trường và phát triển rừng, có mối quan hệ về mục đích sử dụng.</data>
  <data key="d8">bảo vệ môi trường,mục đích sử dụng</data>
