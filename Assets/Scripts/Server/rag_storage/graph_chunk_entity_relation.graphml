  <data key="d6">9.0</data>
  <data key="d7">Ủy ban nhân dân cấp xã thành lập Hội đồng hòa giải tranh chấp đất đai để thực hiện hòa giải.</data>
  <data key="d8">thành lập,thực hiện</data>
