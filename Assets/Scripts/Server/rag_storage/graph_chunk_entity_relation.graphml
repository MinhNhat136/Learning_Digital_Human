</edge>
<edge source="Nhà nước" target="Vùng đồng bào dân tộc thiểu số">
  <data key="d6">8.0</data>
  <data key="d7">Nhà nước hỗ trợ về đất đai cho đồng bào dân tộc thiểu số sinh sống tại vùng đồng bào dân tộc thiểu số.</data>
  <data key="d8">bảo vệ quyền lợi,hỗ trợ</data>
  <data key="d9">chunk-c347cd62ee764c843f0d4fe42e7af593</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739750</data>
</edge>
<edge source="Nhà nước" target="Quy định của pháp luật">
  <data key="d6">9.0</data>
  <data key="d7">Quy định của pháp luật quy định các quy định và luật lệ liên quan đến việc sử dụng và quản lý đất đai của Nhà nước.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-c347cd62ee764c843f0d4fe42e7af593</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739750</data>
</edge>
<edge source="Nhà nước" target="Công an nhân dân">
  <data key="d6">7.0</data>
  <data key="d7">Nhà nước giao đất cho Công an nhân dân để bảo đảm an ninh, trật tự trong khu vực đất sử dụng vào mục đích công cộng.</data>
  <data key="d8">an ninh,trật tự</data>
  <data key="d9">chunk-57d0d9901a36baf8807fac3b75de086a</data>
  <data key="d10">unknown_source</data>
