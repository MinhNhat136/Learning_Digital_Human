<node id="Hội Đồng Nhân Dân Cấp Tỉnh">
  <data key="d0">Hội Đồng Nhân Dân Cấp Tỉnh</data>
  <data key="d1">organization</data>
  <data key="d2">Hội Đồng Nhân Dân Cấp Tỉnh là cơ quan quyền lực nhà nước ở cấp tỉnh, có thẩm quyền quyết định chủ trương đầu tư.</data>
  <data key="d3">chunk-a6763774ff07ff17d62575eed4a3cdb1</data>
