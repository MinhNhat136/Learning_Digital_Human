<edge source="Đất" target="Chủ Đầu Tư">
  <data key="d6">9.0</data>
  <data key="d7">Chủ Đầu Tư được giao đất để thực hiện dự án.</data>
  <data key="d8">dự án,giao đất</data>
  <data key="d9">chunk-5ee8b2d9d90cc3f86f4bf085073fad8b</data>
