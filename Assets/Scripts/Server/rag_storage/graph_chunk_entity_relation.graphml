<edge source="Ủy ban nhân dân cấp xã" target="Đơn vị, tổ chức thực hiện nhiệm vụ bồi thường, hỗ trợ, tái định cư">
  <data key="d6">17.0</data>
  <data key="d7">Đơn vị, tổ chức thực hiện nhiệm vụ bồi thường, hỗ trợ, tái định cư works with Ủy ban nhân dân cấp xã to implement tasks related to compensation, support, and resettlement.&lt;SEP&gt;Ủy ban nhân dân cấp xã works with Đơn vị, tổ chức thực hiện nhiệm vụ bồi thường, hỗ trợ, tái định cư to implement compensation and support tasks.</data>
  <data key="d8">compensation,cooperation,implementation</data>
  <data key="d9">chunk-d3c26e6c9ef2ffca3cc40a0524d879e6&lt;SEP&gt;chunk-90c37b91f9c12815c52aecda9f7bf35f</data>
