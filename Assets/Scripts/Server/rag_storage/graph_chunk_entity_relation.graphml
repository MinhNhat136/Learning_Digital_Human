<node id="Đầm">
  <data key="d0">Đầm</data>
  <data key="d1">geo</data>
  <data key="d2">Đầm là một loại đất có mặt nước được sử dụng vào mục đích nuôi trồng thủy sản, sản xuất nông nghiệp.</data>
  <data key="d3">chunk-44e43c7e34fa8b125c442db95b96f7bd</data>
