  <data key="d11">1749740850</data>
</edge>
<edge source="Đất thu hồi" target="Ban cưỡng chế thu hồi đất">
  <data key="d6">8.0</data>
  <data key="d7">Ban cưỡng chế thu hồi đất is responsible for planning and executing the requisition of Đất thu hồi, which is the land being requisitioned.</data>
  <data key="d8">land management,requisition</data>
