  <data key="d7">Đất sông, ngòi, kênh, rạch, suối được sử dụng cho công trình thủy điện, thủy lợi.</data>
  <data key="d8">sử dụng đất,thủy điện</data>
  <data key="d9">chunk-8bcfa5ac28b38026d775db01dc58f22c</data>
