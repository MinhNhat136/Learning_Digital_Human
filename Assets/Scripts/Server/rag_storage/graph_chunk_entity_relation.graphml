  <data key="d10">unknown_source</data>
  <data key="d11">1749739958</data>
</edge>
<edge source="Nhà tang lễ" target="Cơ sở hỏa táng">
  <data key="d6">7.0</data>
  <data key="d7">Nhà tang lễ và cơ sở hỏa táng là các cơ sở phục vụ cho việc tang lễ và hỏa táng, được quản lý và quy hoạch theo quy định.</data>
  <data key="d8">quy hoạch,quản lý cơ sở</data>
  <data key="d9">chunk-762e815fcef668a5cf9405c822b66d98</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740010</data>
</edge>
<edge source="Tổ Chức Kinh Tế" target="Đơn Vị Sự Nghiệp Công Lập">
  <data key="d6">6.0</data>
  <data key="d7">Tổ Chức Kinh Tế và Đơn Vị Sự Nghiệp Công Lập đều được Nhà Nước giao đất, cho thuê đất để thực hiện các dự án đầu tư.</data>
  <data key="d8">dự án đầu tư,liên quan</data>
  <data key="d9">chunk-6745da57a9dcb099171a6fa7146608f8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740120</data>
</edge>
<edge source="Đơn Vị Sự Nghiệp Công Lập" target="Cụm Công Nghiệp">
  <data key="d6">8.0</data>
  <data key="d7">Cụm Công Nghiệp là khu vực được Đơn Vị Sự Nghiệp Công Lập đầu tư xây dựng kinh doanh kết cấu hạ tầng.</data>
  <data key="d8">khu vực,đầu tư</data>
  <data key="d9">chunk-6745da57a9dcb099171a6fa7146608f8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740120</data>
</edge>
