</edge>
<edge source="Nhà nước" target="Cơ quan nhà nước">
  <data key="d6">8.0</data>
  <data key="d7">Nhà nước giao đất, cho thuê đất, công nhận quyền sử dụng đất cho cơ quan nhà nước.</data>
  <data key="d8">quyền lực,quản lý đất đai</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
