<edge source="Cộng đồng dân cư" target="Đất rừng sản xuất">
  <data key="d6">7.0</data>
  <data key="d7">Cộng đồng dân cư được giao đất rừng sản xuất để bảo vệ và phát triển rừng.</data>
  <data key="d8">bảo vệ rừng,phát triển rừng</data>
