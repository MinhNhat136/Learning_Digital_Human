  <data key="d11">1749740190</data>
</edge>
<edge source="Việc trưng dụng đất" target="Bồi thường thiệt hại">
  <data key="d6">10.0</data>
  <data key="d7">Việc trưng dụng đất gây ra thiệt hại và dẫn đến việc bồi thường thiệt hại cho người có đất trưng dụng và chủ sở hữu tài sản gắn liền với đất trưng dụng.</data>
  <data key="d8">bồi thường thiệt hại,nguyên nhân và kết quả</data>
  <data key="d9">chunk-8fc4053b60ef6cd0c87079f3131b0b96</data>
