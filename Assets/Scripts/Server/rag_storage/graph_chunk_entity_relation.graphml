<edge source="Tổ chức kinh tế" target="Hạn mức giao đất">
  <data key="d6">7.0</data>
  <data key="d7">Tổ chức kinh tế được thuê đất vượt hạn mức giao đất quy định.</data>
  <data key="d8">quy định,sử dụng đất</data>
  <data key="d9">chunk-52e88b1840bd8e004eb0f5e24c9f7e53</data>
