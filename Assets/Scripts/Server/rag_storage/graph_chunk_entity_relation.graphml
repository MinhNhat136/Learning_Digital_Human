  <data key="d11">1749741213</data>
</edge>
<edge source="Chính phủ" target="Khoản 6 Điều 82">
  <data key="d6">8.0</data>
  <data key="d7">Khoản 6 Điều 82 quy định về Chính phủ quy định chi tiết Điều này.</data>
  <data key="d8">quy định,quản lý</data>
