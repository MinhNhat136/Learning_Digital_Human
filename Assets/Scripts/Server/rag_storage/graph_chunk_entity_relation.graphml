</edge>
<edge source="Thu hồi đất" target="Dự án đầu tư">
  <data key="d6">7.0</data>
  <data key="d7">Investment projects may involve land expropriation, which is regulated by the law and policies.</data>
  <data key="d8">investment,land expropriation</data>
