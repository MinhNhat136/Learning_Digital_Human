  <data key="d0">Bản Đồ Địa Chính</data>
  <data key="d1">category</data>
  <data key="d2">Bản đồ địa chính là bản đồ thể hiện các thửa đất và các đối tượng địa lý có liên quan, được lập theo đơn vị hành chính cấp xã hoặc cấp huyện.</data>
  <data key="d3">chunk-3fd1f23cc65520c966ec1d402d52cdf4</data>
