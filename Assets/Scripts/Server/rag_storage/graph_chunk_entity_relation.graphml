  <data key="d0">Điều 79</data>
  <data key="d1">event</data>
  <data key="d2">Điều 79 là một trong những điều khoản quy định về thu hồi đất.&lt;SEP&gt;Điều 79 là một điều khoản cụ thể trong Luật này, quy định về trường hợp Nhà nước thu hồi đất.</data>
  <data key="d3">chunk-2b8e8b07ce0421ff1b0d76e82332a004&lt;SEP&gt;chunk-3e7139acd8a341aeb050adeaeb695058</data>
