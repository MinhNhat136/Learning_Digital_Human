  <data key="d11">1749739942</data>
</edge>
<edge source="Đập, hồ chứa nước" target="Phạm vi bảo vệ và phạm vi phụ cận đập, hồ chứa nước">
  <data key="d6">8.0</data>
  <data key="d7">Đập, hồ chứa nước được bảo vệ và đảm bảo an toàn trong phạm vi bảo vệ và phạm vi phụ cận.</data>
  <data key="d8">an toàn,bảo vệ</data>
