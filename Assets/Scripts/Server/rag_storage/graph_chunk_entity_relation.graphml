  <data key="d11">1749739506</data>
</edge>
<edge source="Cá Nhân" target="Đất Có Di Tích Lịch Sử - Văn Hóa">
  <data key="d6">7.0</data>
  <data key="d7">Cá Nhân uses land with historical and cultural relics, which is regulated by the government.</data>
  <data key="d8">cultural preservation,land use</data>
  <data key="d9">chunk-d863e8048b2ac046f0ff270fb95a47c7</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739796</data>
</edge>
<edge source="Cá Nhân" target="Tổ Chức">
  <data key="d6">8.0</data>
  <data key="d7">Cá nhân và tổ chức đều có quyền và nghĩa vụ trong việc sử dụng đất, và phải tuân thủ quy định của pháp luật.</data>
  <data key="d8">quy định pháp luật,quản lý đất đai</data>
  <data key="d9">chunk-d70bb825a86d3df7a728641869f89f1a</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740595</data>
</edge>
<edge source="Cá Nhân" target="Tổ Chức Tôn Giáo">
  <data key="d6">6.0</data>
  <data key="d7">Cá Nhân có thể cho tổ chức tôn giáo mượn đất.</data>
  <data key="d8">cho mượn,sử dụng đất</data>
  <data key="d9">chunk-a50678dc89e78c25b96d5730912275a1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740935</data>
</edge>
<edge source="Cá Nhân" target="Đất Phi Nông Nghiệp">
  <data key="d6">6.0</data>
  <data key="d7">Cá Nhân uses Đất Phi Nông Nghiệp for various non-agricultural purposes.</data>
  <data key="d8">land use,non-agriculture</data>
  <data key="d9">chunk-89a86f7a9b6d8d610b8e350f06cef698</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780534</data>
</edge>
<edge source="Cá Nhân" target="Đất Cơ Sở Sản Xuất Phi Nông Nghiệp">
  <data key="d6">6.0</data>
  <data key="d7">Cá Nhân uses Đất Cơ Sở Sản Xuất Phi Nông Nghiệp for industrial purposes.</data>
  <data key="d8">industry,land use</data>
  <data key="d9">chunk-89a86f7a9b6d8d610b8e350f06cef698</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780534</data>
</edge>
<edge source="Cá Nhân" target="Đất Nông Nghiệp Cho Cá Nhân">
  <data key="d6">7.0</data>
  <data key="d7">Đất Nông Nghiệp Cho Cá Nhân is allocated to Cá Nhân for agricultural purposes, subject to certain conditions and limits.</data>
  <data key="d8">agricultural land use,individual allocation</data>
  <data key="d9">chunk-3ceb9787248c9d55f9dad634ec631e15</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780534</data>
</edge>
<edge source="Cá Nhân" target="Tổ Chức Kinh Tế">
  <data key="d6">7.0</data>
  <data key="d7">Cá Nhân và Tổ Chức Kinh Tế là đối tượng được nhận quyền sử dụng đất theo quy định của pháp luật.</data>
  <data key="d8">nhận quyền sử dụng đất,pháp luật</data>
  <data key="d9">chunk-441a092bb7fe3b39b917ede05c2b268f</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780819</data>
</edge>
<edge source="Pháp Luật" target="Khu Vực Bảo Vệ">
  <data key="d6">9.0</data>
  <data key="d7">Pháp Luật governs the protection of areas that contain historical and cultural sites.</data>
  <data key="d8">area preservation,legal protection</data>
  <data key="d9">chunk-d45e43e8481e93a8d7815b58b2c67c3e</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739385</data>
</edge>
<edge source="Pháp Luật" target="Mục Đích Khác">
  <data key="d6">6.0</data>
  <data key="d7">Mục Đích Khác is subject to the laws and regulations that govern the preservation and protection of historical and cultural sites.</data>
  <data key="d8">legal regulation,purpose compliance</data>
  <data key="d9">chunk-d45e43e8481e93a8d7815b58b2c67c3e</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739385</data>
</edge>
<edge source="Pháp Luật" target="Quy Định Pháp Luật">
  <data key="d6">10.0</data>
  <data key="d7">Pháp luật bao gồm các quy định pháp luật, và quy định pháp luật là một phần của pháp luật.</data>
  <data key="d8">pháp luật,quy định</data>
  <data key="d9">chunk-d70bb825a86d3df7a728641869f89f1a</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740595</data>
</edge>
<edge source="Giấy Tờ" target="Bản Án">
  <data key="d6">7.0</data>
  <data key="d7">Giấy tờ và bản án là các loại tài liệu chứng minh quyền sở hữu và quy định về xây dựng.</data>
  <data key="d8">chứng minh,tài liệu</data>
  <data key="d9">chunk-0430c7cc3f6209ae0492f4d5eb6ccb39</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739221</data>
</edge>
<edge source="Dự án đầu tư sản xuất nông nghiệp, lâm nghiệp, nuôi trồng thủy sản, làm muối" target="Sản xuất nông nghiệp, lâm nghiệp, nuôi trồng thủy sản, làm muối">
  <data key="d6">8.0</data>
  <data key="d7">Sản xuất nông nghiệp, lâm nghiệp, nuôi trồng thủy sản, làm muối là hoạt động được thực hiện trong dự án đầu tư sản xuất nông nghiệp, lâm nghiệp, nuôi trồng thủy sản, làm muối.</data>
  <data key="d8">dự án đầu tư,sản xuất nông nghiệp</data>
  <data key="d9">chunk-3fd9b376c1da4a3363e3db9b92809484</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739233</data>
</edge>
<edge source="Khu công nghiệp, cụm công nghiệp, khu công nghệ cao, nhà lưu trú công nhân trong khu công nghiệp" target="Khu công nghệ cao">
  <data key="d6">7.0</data>
  <data key="d7">Khu công nghệ cao là một phần của khu công nghiệp, cụm công nghiệp, khu công nghệ cao, nhà lưu trú công nhân trong khu công nghiệp.</data>
  <data key="d8">công nghệ cao,khu công nghiệp</data>
  <data key="d9">chunk-3fd9b376c1da4a3363e3db9b92809484</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739233</data>
</edge>
<edge source="Khu công nghiệp, cụm công nghiệp, khu công nghệ cao, nhà lưu trú công nhân trong khu công nghiệp" target="Nhà lưu trú công nhân trong khu công nghiệp">
  <data key="d6">6.0</data>
  <data key="d7">Nhà lưu trú công nhân trong khu công nghiệp là một phần của khu công nghiệp, cụm công nghiệp, khu công nghệ cao, nhà lưu trú công nhân trong khu công nghiệp.</data>
  <data key="d8">khu công nghiệp,nhà lưu trú công nhân</data>
