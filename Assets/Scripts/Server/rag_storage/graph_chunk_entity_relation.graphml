</node>
<node id="Giấy chứng nhận quyền sử dụng đất">
  <data key="d0">Giấy chứng nhận quyền sử dụng đất</data>
  <data key="d1">category</data>
  <data key="d2">Giấy chứng nhận quyền sử dụng đất là giấy tờ chứng minh quyền sử dụng đất của người sử dụng đất.&lt;SEP&gt;Giấy chứng nhận quyền sử dụng đất là một loại giấy tờ quan trọng trong quá trình thực hiện chính sách đất đai.&lt;SEP&gt;Giấy chứng nhận quyền sử dụng đất là giấy tờ pháp lý chứng minh quyền sử dụng đất của một cá nhân hoặc tổ chức.</data>
  <data key="d3">chunk-32fa20132f34131ad8d6a1dbf22a56db&lt;SEP&gt;chunk-84a885a6c8cdb51f06c780070d62ed55&lt;SEP&gt;chunk-815c63419768ab291e36f773e4370eb9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1749655900</data>
</node>
