  <data key="d11">1749779593</data>
</edge>
<edge source="Công Dân" target="Quyền Lợi Của Công Dân">
  <data key="d6">8.0</data>
  <data key="d7">Quyền lợi của công dân là các quyền và lợi ích của công dân đối với đất đai và pháp luật.</data>
  <data key="d8">công dân,quyền lợi</data>
  <data key="d9">chunk-a67acd907b387c57d147a645186589ae</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738823</data>
</edge>
<edge source="Công Dân" target="Nghĩa Vụ Của Công Dân">
  <data key="d6">8.0</data>
  <data key="d7">Nghĩa vụ của công dân là các trách nhiệm và nghĩa vụ của công dân đối với đất đai và pháp luật.</data>
  <data key="d8">công dân,trách nhiệm</data>
