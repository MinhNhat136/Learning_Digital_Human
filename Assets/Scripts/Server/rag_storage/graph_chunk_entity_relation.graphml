<node id="Tranh Chấp Đất Đai">
  <data key="d0">Tranh Chấp Đất Đai</data>
  <data key="d1">event</data>
  <data key="d2">Tranh Chấp Đất Đai refers to land disputes, which are conflicts between individuals or organizations over land use or ownership.</data>
  <data key="d3">chunk-50b956ea43d3c54759fe2af09d942807</data>
