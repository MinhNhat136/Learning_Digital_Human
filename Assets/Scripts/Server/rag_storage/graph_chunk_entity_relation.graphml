  <data key="d6">8.0</data>
  <data key="d7">Tài sản gắn liền với đất bao gồm cả công trình.</data>
  <data key="d8">công trình,tài sản</data>
  <data key="d9">chunk-ddbdd7c2cec778e794132dbabdaa3544</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741055</data>
</edge>
<edge source="Tài sản gắn liền với đất" target="Chủ sở hữu tài sản gắn liền với đất">
  <data key="d6">9.0</data>
  <data key="d7">Chủ sở hữu tài sản gắn liền với đất sở hữu và quản lý tài sản gắn liền với đất.</data>
  <data key="d8">quản lý tài sản,sở hữu tài sản</data>
