  <data key="d0">Chế độ sở hữu đất đai</data>
  <data key="d1">category</data>
  <data key="d2">Chế độ sở hữu đất đai là một hệ thống quy định về quyền sở hữu và sử dụng đất đai.</data>
  <data key="d3">chunk-a04ff08bad380dd4135e8de69ff04a3f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1749655958</data>
</node>
