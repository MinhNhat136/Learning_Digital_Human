<edge source="Tài sản gắn liền với đất" target="Quyền sở hữu tài sản gắn liền với đất">
  <data key="d6">9.0</data>
  <data key="d7">Quyền sở hữu tài sản gắn liền với đất là quyền được sở hữu tài sản được xây dựng, trồng hoặc tạo ra trên đất, trong khi tài sản gắn liền với đất là tài sản được xây dựng, trồng hoặc tạo ra trên đất.</data>
  <data key="d8">quyền sở hữu,tài sản</data>
  <data key="d9">chunk-cb8f628ae8c6ae843b68f3a8152eb1a6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739491</data>
</edge>
