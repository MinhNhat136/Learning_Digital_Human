</edge>
<edge source="Công trình hạ tầng kỹ thuật" target="Công trình hạ tầng xã hội">
  <data key="d6">7.0</data>
  <data key="d7">Công trình hạ tầng kỹ thuật và công trình hạ tầng xã hội là loại tài sản bị thu hồi khi Nhà nước thu hồi đất.</data>
  <data key="d8">thu hồi đất,tài sản</data>
