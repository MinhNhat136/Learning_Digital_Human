<edge source="Người sử dụng đất" target="Tiền bồi thường">
  <data key="d6">7.0</data>
  <data key="d7">Tiền bồi thường là khoản tiền mà Nhà nước trả cho người sử dụng đất khi thu hồi đất.</data>
  <data key="d8">bồi thường,trả tiền</data>
  <data key="d9">chunk-866fa1465629067de38c51f38907a186</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780214</data>
</edge>
<edge source="Người sử dụng đất" target="Nghĩa vụ tài chính">
  <data key="d6">6.0</data>
  <data key="d7">Nghĩa vụ tài chính là các khoản tiền hoặc tài sản khác mà người sử dụng đất phải trả cho Nhà nước.</data>
  <data key="d8">nghĩa vụ,trả tiền</data>
