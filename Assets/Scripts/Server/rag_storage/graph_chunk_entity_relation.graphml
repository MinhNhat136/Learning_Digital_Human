  <data key="d6">9.0</data>
  <data key="d7">Luật về lâm nghiệp quy định các quy định cụ thể về quản lý và bảo vệ rừng.</data>
  <data key="d8">bảo vệ rừng,quản lý rừng</data>
  <data key="d9">chunk-ea5f0106b317e7328a5942e51b49760c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739258</data>
</edge>
<edge source="Đất rừng sản xuất" target="Doanh nghiệp thuộc lực lượng vũ trang nhân dân">
  <data key="d6">8.0</data>
  <data key="d7">Doanh nghiệp thuộc lực lượng vũ trang nhân dân được thuê đất rừng sản xuất để thực hiện dự án trồng rừng sản xuất.</data>
  <data key="d8">sản xuất rừng,thuê đất</data>
  <data key="d9">chunk-060b8fe077aa42c32e508c67940a02e1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740388</data>
</edge>
