  <data key="d10">unknown_source</data>
  <data key="d11">1749741311</data>
</edge>
<edge source="Chính phủ" target="Điều 240">
  <data key="d6">7.0</data>
  <data key="d7">Điều 240 là quy định pháp luật do Chính phủ ban hành, quy định về xử lý đối với người có hành vi vi phạm pháp luật trong quản lý đất đai khi thi hành công vụ.</data>
  <data key="d8">quy định pháp luật,quản lý đất đai</data>
