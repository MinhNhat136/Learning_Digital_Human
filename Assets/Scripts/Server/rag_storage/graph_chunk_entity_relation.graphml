  <data key="d11">1749740215</data>
</edge>
<edge source="Nghĩa Trang" target="Nhà Tang Lễ">
  <data key="d6">6.0</data>
  <data key="d7">Nghĩa trang và nhà tang lễ là hai trong các trường hợp thu hồi đất.</data>
  <data key="d8">dự án,thu hồi đất</data>
