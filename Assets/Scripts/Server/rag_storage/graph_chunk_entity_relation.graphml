</edge>
<edge source="Giấy Chứng Nhận Quyền Sử Dụng Đất" target="Điều 144">
  <data key="d6">9.0</data>
  <data key="d7">Điều 144 regulates the issuance of Giấy Chứng Nhận Quyền Sử Dụng Đất for land with historical and cultural relics.</data>
  <data key="d8">land use certification,regulatory framework</data>
  <data key="d9">chunk-d863e8048b2ac046f0ff270fb95a47c7</data>
  <data key="d10">unknown_source</data>
