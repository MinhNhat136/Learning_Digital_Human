</edge>
<edge source="Thu hồi đất" target="Bồi thường về đất">
  <data key="d6">16.0</data>
  <data key="d7">Thu hồi đất là nguyên nhân dẫn đến bồi thường về đất.&lt;SEP&gt;Thu hồi đất và bồi thường về đất là hai hành động liên quan của Nhà nước.</data>
  <data key="d8">hành động,kết quả,liên quan,nguyên nhân</data>
  <data key="d9">chunk-5d5c31bb4da02cdff23afe8831cfcb93&lt;SEP&gt;chunk-866fa1465629067de38c51f38907a186</data>
