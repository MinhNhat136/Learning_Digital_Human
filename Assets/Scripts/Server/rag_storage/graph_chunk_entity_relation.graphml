</edge>
<edge source="Hộ gia đình" target="Bồi thường">
  <data key="d6">8.0</data>
  <data key="d7">Hộ gia đình nhận được bồi thường khi Nhà nước thu hồi đất.</data>
  <data key="d8">hỗ trợ,nhận bồi thường</data>
