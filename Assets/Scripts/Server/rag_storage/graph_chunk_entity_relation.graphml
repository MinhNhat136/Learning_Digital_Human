  <data key="d6">7.0</data>
  <data key="d7">Tài sản gắn liền với đất is attached to đất quốc phòng, an ninh and can be used for economic activities.</data>
  <data key="d8">asset management,land use</data>
  <data key="d9">chunk-6cda5729a7fbb9bbf41f35df7a3e07bd</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780667</data>
</edge>
<edge source="Đất quốc phòng, an ninh" target="Tiền sử dụng đất">
  <data key="d6">6.0</data>
  <data key="d7">Tiền sử dụng đất is paid for using đất quốc phòng, an ninh for economic activities.</data>
  <data key="d8">fees,land use</data>
  <data key="d9">chunk-6cda5729a7fbb9bbf41f35df7a3e07bd</data>
  <data key="d10">unknown_source</data>
