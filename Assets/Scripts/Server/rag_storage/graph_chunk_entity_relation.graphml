  <data key="d0">Điều 109</data>
  <data key="d1">event</data>
  <data key="d2">Điều 109 is a specific article of the law that deals with support for households and individuals affected by land confiscation.</data>
  <data key="d3">chunk-2e528eb6259d26484885d9a6e60fbee1</data>
  <data key="d4">unknown_source</data>
