<node id="Mặt trận Tổ quốc Việt Nam">
  <data key="d0">Mặt trận Tổ quốc Việt Nam</data>
  <data key="d1">organization</data>
  <data key="d2">Mặt trận Tổ quốc Việt Nam là một tổ chức chính trị - xã hội được giao đất, cho thuê đất, công nhận quyền sử dụng đất.</data>
  <data key="d3">chunk-815c63419768ab291e36f773e4370eb9</data>
