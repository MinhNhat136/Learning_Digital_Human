  <data key="d1">category</data>
  <data key="d2">Hộ nghèo là loại hộ gia đình được hỗ trợ về đất đai theo chính sách của Nhà nước.</data>
  <data key="d3">chunk-c347cd62ee764c843f0d4fe42e7af593</data>
