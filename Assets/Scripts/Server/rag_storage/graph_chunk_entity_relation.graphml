  <data key="d10">unknown_source</data>
  <data key="d11">1749741213</data>
</edge>
<edge source="Chính phủ" target="Người có hành vi vi phạm pháp luật">
  <data key="d6">8.0</data>
  <data key="d7">Chính phủ quy định chi tiết các hành vi vi phạm pháp luật trong quản lý đất đai khi thi hành công vụ, mà người có hành vi vi phạm pháp luật có thể bị xử lý kỷ luật hoặc truy cứu trách nhiệm hình sự.</data>
  <data key="d8">quy định pháp luật,xử lý vi phạm</data>
