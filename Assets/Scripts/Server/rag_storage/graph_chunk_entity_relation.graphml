<edge source="Tiền thuê đất" target="Quyền thuê đất">
  <data key="d6">8.0</data>
  <data key="d7">Quyền thuê đất liên quan đến việc trả tiền thuê đất cho Nhà nước.</data>
  <data key="d8">quyền sử dụng đất,tài chính</data>
  <data key="d9">chunk-b76eee198190c400585c70128496fffd</data>
