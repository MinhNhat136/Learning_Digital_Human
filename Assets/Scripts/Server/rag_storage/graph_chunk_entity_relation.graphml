</edge>
<edge source="Đất Đai" target="Tài Nguyên">
  <data key="d6">8.0</data>
  <data key="d7">Tài Nguyên là nguồn lực hoặc nguyên liệu được sử dụng để phát triển kinh tế và xã hội trên Đất Đai.</data>
  <data key="d8">nguồn lực,phát triển</data>
  <data key="d9">chunk-0af8c1d084adb05c320cf722f9de8fd6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655926</data>
</edge>
<edge source="Bề Mặt Đất" target="Lòng Đất">
  <data key="d6">7.0</data>
  <data key="d7">Bề Mặt Đất và Lòng Đất là hai khu vực hoặc không gian khác nhau trên và dưới lòng đất.</data>
  <data key="d8">khu vực,không gian</data>
