  <data key="d0">Hạn mức giao đất ở</data>
  <data key="d1">category</data>
  <data key="d2">Hạn mức giao đất ở là giới hạn về diện tích đất ở mà người sử dụng đất được phép sử dụng.</data>
  <data key="d3">chunk-3d7430474b8c0567cb4969f22ad7777e</data>
