  <data key="d10">unknown_source</data>
  <data key="d11">1749738823</data>
</edge>
<edge source="Công Dân" target="Cơ Quan Nhà Nước">
  <data key="d6">8.0</data>
  <data key="d7">Công Dân có quyền giám sát, phản ánh và yêu cầu, kiến nghị Cơ Quan Nhà Nước xử lý các sai phạm trong quản lý, sử dụng đất đai.</data>
  <data key="d8">quyền giám sát,trách nhiệm giải trình</data>
  <data key="d9">chunk-36ce2f232200c55d5fcf1104010b03a8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739764</data>
</edge>
<edge source="Công Dân" target="Tổ Chức Đại Diện">
  <data key="d6">8.0</data>
  <data key="d7">Tổ Chức Đại Diện đại diện cho quyền lợi của Công Dân trong việc giám sát và bảo vệ đất đai.</data>
  <data key="d8">bảo vệ quyền lợi,đại diện</data>
  <data key="d9">chunk-36ce2f232200c55d5fcf1104010b03a8</data>
