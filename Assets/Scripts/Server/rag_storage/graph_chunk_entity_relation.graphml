  <data key="d11">1749790234</data>
</edge>
<edge source="Người có đất thu hồi" target="Ủy ban Mặt trận Tổ quốc Việt Nam cấp xã">
  <data key="d6">6.0</data>
  <data key="d7">Ủy ban Mặt trận Tổ quốc Việt Nam cấp xã tham gia vào việc vận động, thuyết phục người có đất thu hồi.</data>
