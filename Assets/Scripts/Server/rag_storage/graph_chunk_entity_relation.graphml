  <data key="d11">1749740968</data>
</edge>
<edge source="Quyền sử dụng đất" target="Thừa kế quyền sử dụng đất">
  <data key="d6">8.0</data>
  <data key="d7">Thừa kế quyền sử dụng đất là việc chuyển giao quyền sử dụng đất từ người này sang người khác thông qua thừa kế.</data>
  <data key="d8">quyền sở hữu,thừa kế quyền sử dụng đất</data>
  <data key="d9">chunk-6b61fb11d65754bf7d1e573040ac7e65</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738948</data>
</edge>
<edge source="Quyền sử dụng đất" target="Quyền sở hữu tài sản gắn liền với đất">
  <data key="d6">17.0</data>
  <data key="d7">Quyền sử dụng đất và Quyền sở hữu tài sản gắn liền với đất là hai quyền liên quan đến việc sử dụng và sở hữu tài sản trên đất.&lt;SEP&gt;Quyền sử dụng đất và quyền sở hữu tài sản gắn liền với đất là hai quyền liên quan đến đất đai.</data>
