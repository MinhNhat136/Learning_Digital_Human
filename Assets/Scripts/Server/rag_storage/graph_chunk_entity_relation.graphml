  <data key="d11">1749741311</data>
</edge>
<edge source="Bồi thường" target="Đất thu hồi">
  <data key="d6">8.0</data>
  <data key="d7">Đất thu hồi is related to Bồi thường as compensation is provided for the acquired land.</data>
  <data key="d8">compensation,land acquisition</data>
