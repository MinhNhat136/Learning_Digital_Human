</edge>
<edge source="Ngân sách nhà nước" target="Nguồn vốn hợp pháp khác">
  <data key="d6">8.0</data>
  <data key="d7">Ngân sách nhà nước và nguồn vốn hợp pháp khác đều được sử dụng để hỗ trợ và thực hiện chính sách về đất đai đối với đồng bào dân tộc thiểu số.</data>
  <data key="d8">hỗ trợ,tài trợ</data>
