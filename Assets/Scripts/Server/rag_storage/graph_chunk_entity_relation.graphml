  <data key="d11">1749780600</data>
</edge>
<edge source="Hộ gia đình" target="Người đại diện hộ gia đình">
  <data key="d6">7.0</data>
  <data key="d7">Người đại diện hộ gia đình là người được ủy quyền để thực hiện các giao dịch liên quan đến đất đai và tài sản gắn liền với đất của hộ gia đình.</data>
  <data key="d8">giao dịch,ủy quyền</data>
  <data key="d9">chunk-69fac412dce6f11bdbabb60381fd462e</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738806</data>
</edge>
<edge source="Hộ gia đình" target="Thành viên hộ gia đình">
  <data key="d6">6.0</data>
  <data key="d7">Thành viên hộ gia đình là những người cùng chung sống và có quyền sử dụng đất của hộ gia đình.</data>
  <data key="d8">chung sống,thành viên</data>
  <data key="d9">chunk-69fac412dce6f11bdbabb60381fd462e</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738806</data>
</edge>
<edge source="Hộ gia đình" target="Địa phương">
  <data key="d6">7.0</data>
  <data key="d7">Hộ gia đình are located in Địa phương and are affected by land confiscation.</data>
