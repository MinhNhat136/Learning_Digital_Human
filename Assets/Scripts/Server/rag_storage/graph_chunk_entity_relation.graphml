  <data key="d10">unknown_source</data>
  <data key="d11">1749740958</data>
</edge>
<edge source="Đơn Vị Hành Chính Cấp Xã" target="Phường">
  <data key="d6">9.0</data>
  <data key="d7">Phường is a type of Đơn Vị Hành Chính Cấp Xã, an administrative unit at the communal level.</data>
  <data key="d8">administrative division,communal unit</data>
  <data key="d9">chunk-e6ffdf3f5c842a4183f8dfc1e3a8edaf</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740958</data>
</edge>
<edge source="Đơn Vị Hành Chính Cấp Xã" target="Thị Trấn">
  <data key="d6">9.0</data>
  <data key="d7">Thị Trấn is a type of Đơn Vị Hành Chính Cấp Xã, an administrative unit at the communal level.</data>
  <data key="d8">administrative division,communal unit</data>
  <data key="d9">chunk-e6ffdf3f5c842a4183f8dfc1e3a8edaf</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740958</data>
</edge>
<edge source="Đấu thầu lựa chọn nhà đầu tư" target="Dự án đầu tư có sử dụng đất">
  <data key="d6">9.0</data>
  <data key="d7">Đấu thầu lựa chọn nhà đầu tư is the process used to select investors for Dự án đầu tư có sử dụng đất, investment projects involving land use and development.</data>
  <data key="d8">investment,selection</data>
  <data key="d9">chunk-97d287b73c1faeec510d9b6519782d3c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Đấu thầu lựa chọn nhà đầu tư" target="Nhà đầu tư nước ngoài">
  <data key="d6">7.0</data>
  <data key="d7">Nhà đầu tư nước ngoài participates in Đấu thầu lựa chọn nhà đầu tư, the bidding process for selecting investors for land development projects.</data>
  <data key="d8">bidding,investment</data>
  <data key="d9">chunk-97d287b73c1faeec510d9b6519782d3c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Dự án đầu tư có sử dụng đất" target="Khu đất thực hiện đấu thầu dự án đầu tư có sử dụng đất">
  <data key="d6">8.0</data>
  <data key="d7">Khu đất thực hiện đấu thầu dự án đầu tư có sử dụng đất is the area of land designated for Dự án đầu tư có sử dụng đất, investment projects involving land use and development.</data>
  <data key="d8">development,land use</data>
  <data key="d9">chunk-97d287b73c1faeec510d9b6519782d3c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Dự án đầu tư có sử dụng đất" target="Hợp đồng">
  <data key="d6">9.0</data>
  <data key="d7">Hợp đồng is signed between investors and the government for Dự án đầu tư có sử dụng đất, investment projects that involve land use and development.</data>
  <data key="d8">contract,investment</data>
  <data key="d9">chunk-97d287b73c1faeec510d9b6519782d3c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Khu đất thực hiện đấu thầu dự án đầu tư có sử dụng đất" target="Quy hoạch phân khu tỷ lệ 1/2000">
  <data key="d6">7.0</data>
  <data key="d7">Quy hoạch phân khu tỷ lệ 1/2000 is used to plan Khu đất thực hiện đấu thầu dự án đầu tư có sử dụng đất, the areas of land designated for development projects.</data>
  <data key="d8">land use,planning</data>
  <data key="d9">chunk-97d287b73c1faeec510d9b6519782d3c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Đấu thầu" target="Dự án có sử dụng đất">
  <data key="d6">10.0</data>
  <data key="d7">Đấu thầu là quá trình để lựa chọn nhà đầu tư thực hiện dự án có sử dụng đất.</data>
  <data key="d8">lựa chọn,thực hiện</data>
  <data key="d9">chunk-c2cd3c16a8868bb46c198c542de8569e</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Đấu thầu" target="Quy định của pháp luật về đấu thầu">
  <data key="d6">9.0</data>
  <data key="d7">Quy định của pháp luật về đấu thầu hướng dẫn và quản lý quá trình đấu thầu.</data>
  <data key="d8">hướng dẫn,quản lý</data>
  <data key="d9">chunk-c2cd3c16a8868bb46c198c542de8569e</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Tổ chức, cá nhân" target="Hồ sơ đề nghị giao đất, cho thuê đất">
  <data key="d6">7.0</data>
  <data key="d7">Tổ chức, cá nhân submits Hồ sơ đề nghị giao đất, cho thuê đất for land allocation or lease.</data>
  <data key="d8">application process,land use</data>
  <data key="d9">chunk-9ca0666d9ee9dc9838455e6bd349f7f2</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741039</data>
</edge>
<edge source="Cơ sở dữ liệu đất đai" target="Hồ sơ địa chính">
  <data key="d6">8.0</data>
  <data key="d7">Cơ sở dữ liệu đất đai is linked to Hồ sơ địa chính for land information management.</data>
  <data key="d8">data integration,land information</data>
  <data key="d9">chunk-9ca0666d9ee9dc9838455e6bd349f7f2</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741039</data>
</edge>
