</edge>
<edge source="Ủy ban nhân dân cấp xã" target="Chủ tịch Ủy ban nhân dân cấp huyện">
  <data key="d6">10.0</data>
  <data key="d7">Chủ tịch Ủy ban nhân dân cấp huyện has the authority to make decisions related to land acquisition and compensation, and works with Ủy ban nhân dân cấp xã to implement these decisions.</data>
  <data key="d8">authority,decision-making</data>
