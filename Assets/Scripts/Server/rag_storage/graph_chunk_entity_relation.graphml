<edge source="Nhà nước" target="Phương án bồi thường, hỗ trợ, tái định cư">
  <data key="d6">8.0</data>
  <data key="d7">Nhà nước phê duyệt phương án bồi thường, hỗ trợ, tái định cư khi thu hồi đất.</data>
  <data key="d8">bồi thường,thu hồi đất</data>
