</edge>
<edge source="Tổ chức kinh tế có vốn đầu tư nước ngoài" target="Dự án đầu tư sản xuất muối">
  <data key="d6">8.0</data>
  <data key="d7">Tổ chức kinh tế có vốn đầu tư nước ngoài thực hiện dự án đầu tư sản xuất muối.</data>
  <data key="d8">kinh tế,đầu tư sản xuất</data>
