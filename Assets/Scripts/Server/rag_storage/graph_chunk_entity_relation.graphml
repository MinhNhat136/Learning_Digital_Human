<edge source="Thu hồi đất" target="Tái định cư">
  <data key="d6">9.0</data>
  <data key="d7">Thu hồi đất và tái định cư có mối quan hệ trong việc di chuyển và tái định cư cho những người có đất thu hồi.</data>
  <data key="d8">di chuyển,tái định cư</data>
