<edge source="Ủy Ban Nhân Dân" target="Tòa Án">
  <data key="d6">7.0</data>
  <data key="d7">Ủy Ban Nhân Dân và Tòa Án có thẩm quyền trong việc giải quyết tranh chấp đất đai và các vụ việc liên quan đến đất đai.</data>
  <data key="d8">giải quyết tranh chấp,thẩm quyền</data>
  <data key="d9">chunk-4cdffa592834f59c1831a91e8118b491</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738948</data>
</edge>
<edge source="Ủy Ban Nhân Dân" target="Quy Định Của Pháp Luật">
  <data key="d6">8.0</data>
  <data key="d7">Ủy Ban Nhân Dân oversees the implementation of Quy Định Của Pháp Luật.</data>
  <data key="d8">government oversight,regulatory compliance</data>
  <data key="d9">chunk-d863e8048b2ac046f0ff270fb95a47c7</data>
