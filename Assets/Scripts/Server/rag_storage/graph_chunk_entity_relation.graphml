  <data key="d11">1749739745</data>
</edge>
<edge source="Nhà nước" target="Miền núi">
  <data key="d6">8.0</data>
  <data key="d7">Nhà nước hỗ trợ về đất đai cho đồng bào dân tộc thiểu số sinh sống tại miền núi.</data>
  <data key="d8">bảo vệ quyền lợi,hỗ trợ</data>
