  <data key="d0">Đất ở tại đô thị</data>
  <data key="d1">category</data>
  <data key="d2">Đất ở tại đô thị là đất để làm nhà ở và mục đích khác phục vụ cho đời sống trong cùng một thửa đất thuộc khu vực đô thị.</data>
  <data key="d3">chunk-0b2e5ed2f2918cffd9720d5587d41ab6</data>
