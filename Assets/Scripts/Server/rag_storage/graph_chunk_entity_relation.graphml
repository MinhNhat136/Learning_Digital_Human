<node id="Quyết Định Cho Thuê Đất">
  <data key="d0">Quyết Định Cho Thuê Đất</data>
  <data key="d1">event</data>
  <data key="d2">Quyết Định Cho Thuê Đất is a decision to lease land, which may be subject to various regulations and laws.&lt;SEP&gt;Quyết Định Cho Thuê Đất refers to the decision to lease land, which is a significant event in land use and ownership regulations.</data>
  <data key="d3">chunk-86abc2f785af8819301d6dab6669b583&lt;SEP&gt;chunk-917b6ccefd2918f28d83c9a5da27c3a6</data>
  <data key="d4">unknown_source</data>
