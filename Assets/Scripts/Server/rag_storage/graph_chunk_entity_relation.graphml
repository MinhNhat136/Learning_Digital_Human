</edge>
<edge source="Ủy Ban Nhân Dân Cấp Tỉnh" target="Ban Quản Lý Rừng">
  <data key="d6">7.0</data>
  <data key="d7">Ủy Ban Nhân Dân Cấp Tỉnh works with Ban Quản Lý Rừng to manage and protect forests.</data>
  <data key="d8">forest management,interagency cooperation</data>
  <data key="d9">chunk-6d1525b95b179b824b107bac6bd2f0ef</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740083</data>
</edge>
