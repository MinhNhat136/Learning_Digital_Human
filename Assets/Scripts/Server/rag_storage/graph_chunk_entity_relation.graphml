</node>
<node id="Pháp luật về đấu thầu">
  <data key="d0">Pháp luật về đấu thầu</data>
  <data key="d1">category</data>
  <data key="d2">Pháp luật về đấu thầu là hệ thống quy định và luật lệ quản lý hoạt động đấu thầu.&lt;SEP&gt;Pháp luật về đấu thầu là hệ thống quy định và nguyên tắc pháp lý điều chỉnh các hoạt động đấu thầu.&lt;SEP&gt;Pháp luật về đấu thầu là hệ thống quy định và nguyên tắc pháp lý điều chỉnh các hoạt động đấu thầu.</data>
  <data key="d3">chunk-b236a9e776917e7987550623ac9f05a5&lt;SEP&gt;chunk-3e7139acd8a341aeb050adeaeb695058</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1749790290</data>
</node>
