<edge source="Người Việt Nam định cư ở nước ngoài" target="Doanh nghiệp có vốn đầu tư nước ngoài">
  <data key="d6">7.0</data>
  <data key="d7">Người Việt Nam định cư ở nước ngoài may invest in Doanh nghiệp có vốn đầu tư nước ngoài, which can be involved in land use and development.</data>
  <data key="d8">business,investment,land use</data>
  <data key="d9">chunk-315e6159cb2573d8ce5fae8d943c3158</data>
  <data key="d10">unknown_source</data>
