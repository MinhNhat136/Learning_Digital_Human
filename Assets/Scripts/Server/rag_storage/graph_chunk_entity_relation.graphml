  <data key="d11">1749739447</data>
</edge>
<edge source="Đất đai" target="Chế độ sở hữu đất đai">
  <data key="d6">9.0</data>
  <data key="d7">Chế độ sở hữu đất đai quy định về quyền sở hữu và sử dụng đất đai.</data>
  <data key="d8">quy định,sở hữu đất đai</data>
