  <data key="d6">9.0</data>
  <data key="d7">Hành lang bảo vệ an toàn công trình được quy định để bảo vệ an toàn công trình.</data>
  <data key="d8">an toàn,bảo vệ</data>
  <data key="d9">chunk-ddbdd7c2cec778e794132dbabdaa3544</data>
  <data key="d10">unknown_source</data>
