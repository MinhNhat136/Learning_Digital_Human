</edge>
<edge source="Người Việt Nam định cư ở nước ngoài" target="Khu công nghệ cao">
  <data key="d6">5.0</data>
  <data key="d7">Người Việt Nam định cư ở nước ngoài, overseas Vietnamese, can invest in Khu công nghệ cao, high-tech zones.</data>
  <data key="d8">innovation,investment</data>
  <data key="d9">chunk-cad398132568f5feedf3d3e5d0967e63</data>
  <data key="d10">unknown_source</data>
