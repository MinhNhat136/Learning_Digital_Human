  <data key="d1">geo</data>
  <data key="d2">Vùng đồng bào dân tộc thiểu số là khu vực địa lý nơi đồng bào dân tộc thiểu số sinh sống và được Nhà nước hỗ trợ về đất đai.</data>
  <data key="d3">chunk-c347cd62ee764c843f0d4fe42e7af593</data>
