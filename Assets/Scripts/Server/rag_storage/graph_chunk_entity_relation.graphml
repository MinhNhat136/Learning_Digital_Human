  <data key="d11">1749655737</data>
</edge>
<edge source="Nhà nước" target="Công nhận quyền sử dụng đất">
  <data key="d6">8.0</data>
  <data key="d7">Nhà nước công nhận quyền sử dụng đất của người sử dụng đất, và có quyền quyết định về hạn mức sử dụng đất.</data>
  <data key="d8">quyền công nhận,quản lý</data>
