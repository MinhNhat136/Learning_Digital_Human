  <data key="d6">7.0</data>
  <data key="d7">Cơ quan nhà nước quản lý và cấp phép cho tổ chức kinh tế.</data>
  <data key="d8">cấp phép,quản lý</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
