  <data key="d10">unknown_source</data>
  <data key="d11">1749739750</data>
</edge>
<edge source="Ngân sách nhà nước" target="Hội đồng">
  <data key="d6">8.0</data>
  <data key="d7">Hội đồng được thành lập để xác định mức bồi thường thiệt hại do thực hiện trưng dụng đất gây ra, và ngân sách nhà nước có trách nhiệm chi trả tiền bồi thường.</data>
  <data key="d8">chi trả,trách nhiệm</data>
