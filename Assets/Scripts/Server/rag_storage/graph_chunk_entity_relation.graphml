  <data key="d10">unknown_source</data>
  <data key="d11">1749655737</data>
</edge>
<edge source="Nhà nước" target="Cho thuê đất">
  <data key="d6">7.0</data>
  <data key="d7">Nhà nước cho người sử dụng đất sử dụng đất trong một thời gian nhất định, và có quyền quyết định về hạn mức sử dụng đất.</data>
  <data key="d8">quyền cho thuê đất,quản lý</data>
