</edge>
<edge source="Chủ sở hữu toàn dân" target="Toàn dân">
  <data key="d6">10.0</data>
  <data key="d7">Toàn dân là chủ sở hữu toàn dân, có quyền sở hữu và quản lý đất đai, được đại diện bởi cơ quan nhà nước.</data>
  <data key="d8">quản lý,sở hữu</data>
  <data key="d9">chunk-14f425d966c49e0fd0eafa96bfab983c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655843</data>
</edge>
<edge source="Pháp luật" target="Quy định">
  <data key="d6">9.0</data>
  <data key="d7">Quy định là một phần của pháp luật, cung cấp các quy tắc và luật lệ cụ thể cho việc quản lý và sử dụng đất đai.</data>
  <data key="d8">luật lệ,quy định</data>
  <data key="d9">chunk-14f425d966c49e0fd0eafa96bfab983c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655843</data>
</edge>
<edge source="Pháp luật" target="Đối tượng khác">
  <data key="d6">8.0</data>
  <data key="d7">Đối tượng khác phải tuân thủ pháp luật về đất đai, đảm bảo sử dụng đất đai theo quy định và đúng pháp luật.</data>
  <data key="d8">thực hiện,tuân thủ</data>
  <data key="d9">chunk-14f425d966c49e0fd0eafa96bfab983c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655843</data>
</edge>
<edge source="Pháp luật" target="Quản lý đất">
  <data key="d6">10.0</data>
  <data key="d7">Pháp luật quy định và điều chỉnh các hoạt động quản lý đất.</data>
  <data key="d8">pháp luật,quản lý đất</data>
  <data key="d9">chunk-df1cf85b8f6adb27f254ca957d057cb7</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655983</data>
</edge>
<edge source="Tổ chức kinh tế" target="Luật Đầu tư">
  <data key="d6">9.0</data>
  <data key="d7">Luật Đầu tư quy định về tổ chức kinh tế.</data>
  <data key="d8">pháp luật,quản lý kinh tế</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655865</data>
</edge>
<edge source="Tổ chức kinh tế" target="Tổ chức tôn giáo">
  <data key="d6">6.0</data>
  <data key="d7">Tổ chức kinh tế và tổ chức tôn giáo đều được giao đất, cho thuê đất, công nhận quyền sử dụng đất.</data>
  <data key="d8">quyền lợi,đối tượng sử dụng đất</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655865</data>
</edge>
<edge source="Tổ chức kinh tế" target="Giấy chứng nhận quyền sử dụng đất">
  <data key="d6">7.0</data>
  <data key="d7">Tổ chức kinh tế được cấp Giấy chứng nhận quyền sử dụng đất khi được giao đất, cho thuê đất, công nhận quyền sử dụng đất.</data>
  <data key="d8">giấy tờ chứng minh,quyền lợi</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655865</data>
</edge>
<edge source="Tổ chức kinh tế" target="Dự án đầu tư">
  <data key="d6">8.0</data>
  <data key="d7">Tổ chức kinh tế thực hiện dự án đầu tư trên đất được giao quản lý.</data>
  <data key="d8">kinh tế,đầu tư</data>
  <data key="d9">chunk-df1cf85b8f6adb27f254ca957d057cb7</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655983</data>
</edge>
<edge source="Tổ chức tôn giáo" target="Cá nhân">
  <data key="d6">6.0</data>
  <data key="d7">Tổ chức tôn giáo và cá nhân đều được giao đất, cho thuê đất, công nhận quyền sử dụng đất.</data>
  <data key="d8">quyền lợi,đối tượng sử dụng đất</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655865</data>
</edge>
<edge source="Cá nhân" target="Giấy chứng nhận quyền sử dụng đất">
  <data key="d6">7.0</data>
  <data key="d7">Cá nhân được cấp Giấy chứng nhận quyền sử dụng đất khi được giao đất, cho thuê đất, công nhận quyền sử dụng đất.</data>
  <data key="d8">giấy tờ chứng minh,quyền lợi</data>
  <data key="d9">chunk-815c63419768ab291e36f773e4370eb9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655865</data>
</edge>
<edge source="Cá nhân" target="Cộng đồng dân cư">
  <data key="d6">6.0</data>
  <data key="d7">Cá nhân là thành viên của cộng đồng dân cư, có quyền sử dụng đất chung, thể hiện mối quan hệ giữa cá nhân và cộng đồng.</data>
  <data key="d8">cộng đồng,thành viên</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Ủy ban nhân dân cấp xã">
  <data key="d6">8.0</data>
  <data key="d7">Ủy ban nhân dân cấp xã có trách nhiệm xác nhận giấy tờ về đất sử dụng chung cho cộng đồng dân cư, thể hiện mối quan hệ giữa cơ quan hành chính và cộng đồng.</data>
  <data key="d8">cộng đồng,hành chính</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Đất sử dụng chung">
  <data key="d6">7.0</data>
  <data key="d7">Cộng đồng dân cư có quyền sử dụng đất chung, thể hiện mối quan hệ giữa cộng đồng và đất sử dụng chung.</data>
  <data key="d8">cộng đồng,sử dụng đất</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Hộ gia đình">
  <data key="d6">6.0</data>
  <data key="d7">Hộ gia đình là đơn vị gia đình sống trong một khu vực địa lý nhất định, có quyền sử dụng đất chung, thể hiện mối quan hệ giữa hộ gia đình và cộng đồng.</data>
  <data key="d8">cộng đồng,đơn vị gia đình</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Khu vực địa lý">
  <data key="d6">7.0</data>
  <data key="d7">Khu vực địa lý là vùng lãnh thổ nơi cộng đồng dân cư sống và sử dụng đất chung, thể hiện mối quan hệ giữa khu vực địa lý và cộng đồng.</data>
  <data key="d8">cộng đồng,vùng lãnh thổ</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Trưởng thôn, làng, ấp, bản, bon, buôn, phum, sóc, tổ dân phố và điểm dân cư tương tự">
  <data key="d6">7.0</data>
  <data key="d7">Trưởng thôn, làng, ấp, bản, bon, buôn, phum, sóc, tổ dân phố và điểm dân cư tương tự là người đại diện cho cộng đồng dân cư, có trách nhiệm quản lý và sử dụng đất theo quy định của pháp luật.</data>
  <data key="d8">quản lý,đại diện</data>
  <data key="d9">chunk-2c36ecaddfd4da25d70ed2760df7e6f1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655940</data>
</edge>
<edge source="Cộng đồng dân cư" target="Đất">
  <data key="d6">8.0</data>
  <data key="d7">Cộng đồng dân cư được giao quản lý đất cho mục đích công cộng.</data>
  <data key="d8">giao quản lý,quản lý đất</data>
  <data key="d9">chunk-df1cf85b8f6adb27f254ca957d057cb7</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655983</data>
</edge>
<edge source="Cộng đồng dân cư" target="Người đại diện cho cộng đồng dân cư">
  <data key="d6">9.0</data>
  <data key="d7">Người đại diện cho cộng đồng dân cư là người chịu trách nhiệm đối với đất được giao cho cộng đồng dân cư quản lý.</data>
  <data key="d8">quản lý đất,trách nhiệm</data>
  <data key="d9">chunk-df1cf85b8f6adb27f254ca957d057cb7</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655983</data>
</edge>
<edge source="Giấy chứng nhận quyền sử dụng đất" target="Cơ quan nhà nước có thẩm quyền">
  <data key="d6">8.0</data>
  <data key="d7">Giấy chứng nhận quyền sử dụng đất được cấp bởi cơ quan nhà nước có thẩm quyền.</data>
  <data key="d8">government certification,land ownership</data>
  <data key="d9">chunk-32fa20132f34131ad8d6a1dbf22a56db</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655900</data>
</edge>
<edge source="Giấy chứng nhận quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất" target="Ủy ban nhân dân cấp xã">
  <data key="d6">9.0</data>
  <data key="d7">Giấy chứng nhận quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất được cấp dựa trên xác nhận của Ủy ban nhân dân cấp xã, thể hiện mối quan hệ giữa giấy tờ pháp lý và cơ quan hành chính.</data>
  <data key="d8">hành chính,pháp lý</data>
