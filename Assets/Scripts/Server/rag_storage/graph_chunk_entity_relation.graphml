  <data key="d6">8.0</data>
  <data key="d7">Tiền bồi thường, hỗ trợ, tái định cư được trả cho người có đất thu hồi để hỗ trợ họ ổn định cuộc sống.</data>
  <data key="d8">hỗ trợ,ổn định</data>
  <data key="d9">chunk-0743b26cc10fd114324111258622fca2</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780209</data>
</edge>
<edge source="Người có đất thu hồi" target="Văn bản thông báo thu hồi đất">
  <data key="d6">8.0</data>
  <data key="d7">Văn bản thông báo thu hồi đất được gửi đến người có đất thu hồi để thông báo về việc thu hồi đất.</data>
  <data key="d8">quyền lợi,thông báo</data>
  <data key="d9">chunk-e2b19b2941f2360159ddcc63063f87b8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780799</data>
</edge>
<edge source="Người có đất thu hồi" target="Kế hoạch di dời người dân">
  <data key="d6">7.0</data>
  <data key="d7">Kế hoạch di dời người dân được xây dựng để di dời người dân khỏi khu vực thu hồi đất.</data>
  <data key="d8">di dời,tái định cư</data>
  <data key="d9">chunk-e2b19b2941f2360159ddcc63063f87b8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780799</data>
</edge>
<edge source="Người có đất thu hồi" target="Kế hoạch bồi thường, hỗ trợ, tái định cư">
  <data key="d6">8.0</data>
  <data key="d7">Kế hoạch bồi thường, hỗ trợ, tái định cư được xây dựng để hỗ trợ người có đất thu hồi và các bên liên quan.</data>
  <data key="d8">hỗ trợ,tái định cư</data>
  <data key="d9">chunk-e2b19b2941f2360159ddcc63063f87b8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780799</data>
</edge>
<edge source="Người có đất thu hồi" target="Chủ sở hữu tài sản gắn liền với đất">
  <data key="d6">7.0</data>
  <data key="d7">Người có đất thu hồi and Chủ sở hữu tài sản gắn liền với đất are individuals who are affected by the land acquisition and have rights and interests related to the land and assets.</data>
  <data key="d8">asset ownership,land ownership</data>
  <data key="d9">chunk-d3c26e6c9ef2ffca3cc40a0524d879e6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749790234</data>
</edge>
<edge source="Chủ sở hữu tài sản" target="Tài sản">
  <data key="d6">8.0</data>
  <data key="d7">Chủ sở hữu tài sản bị thiệt hại về tài sản khi Nhà nước thu hồi đất và được bồi thường.</data>
  <data key="d8">bồi thường,sở hữu</data>
  <data key="d9">chunk-c5292ad6f8216f1df76baad254080945</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738907</data>
</edge>
<edge source="Chủ sở hữu tài sản" target="Bồi thường tài sản">
  <data key="d6">9.0</data>
  <data key="d7">Bồi thường tài sản là việc trả lại giá trị của tài sản gắn liền với đất cho chủ sở hữu tài sản.</data>
  <data key="d8">sự kiện,trả lại giá trị</data>
  <data key="d9">chunk-339de19e4280c39c7a1aa011d12e155a</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739958</data>
</edge>
<edge source="Khu tái định cư" target="Hạ tầng kỹ thuật">
  <data key="d6">6.0</data>
  <data key="d7">Khu tái định cư được xây dựng với hạ tầng kỹ thuật để phục vụ nhu cầu của người dân.</data>
  <data key="d8">cơ sở vật chất,phục vụ</data>
  <data key="d9">chunk-c5292ad6f8216f1df76baad254080945</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738907</data>
</edge>
<edge source="Khu tái định cư" target="Hạ tầng xã hội">
  <data key="d6">6.0</data>
  <data key="d7">Khu tái định cư được xây dựng với hạ tầng xã hội để phục vụ nhu cầu của người dân.</data>
  <data key="d8">cơ sở vật chất,phục vụ</data>
  <data key="d9">chunk-c5292ad6f8216f1df76baad254080945</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738907</data>
</edge>
<edge source="Khu tái định cư" target="Hộ gia đình, cá nhân">
  <data key="d6">8.0</data>
  <data key="d7">Khu tái định cư is the relocation area where Hộ gia đình, cá nhân is being moved to after their land is taken away.</data>
  <data key="d8">compensation,relocation</data>
  <data key="d9">chunk-a5c1d8b94fca776ce4e0aa562c32503b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739320</data>
</edge>
<edge source="Khu tái định cư" target="Người có đất ở bị thu hồi">
  <data key="d6">8.0</data>
  <data key="d7">Người có đất ở bị thu hồi is being relocated to Khu tái định cư after their land is taken away.</data>
  <data key="d8">compensation,relocation</data>
  <data key="d9">chunk-a5c1d8b94fca776ce4e0aa562c32503b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739320</data>
</edge>
<edge source="Khu tái định cư" target="Khu đô thị">
  <data key="d6">8.0</data>
  <data key="d7">Khu đô thị and Khu tái định cư are both related to urban development and relocation.</data>
  <data key="d8">relocation,urbanization</data>
  <data key="d9">chunk-a5c1d8b94fca776ce4e0aa562c32503b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739320</data>
</edge>
<edge source="Phương án bồi thường, hỗ trợ, tái định cư" target="Giá đất cụ thể">
  <data key="d6">9.0</data>
  <data key="d7">Phương án bồi thường, hỗ trợ, tái định cư được lập dựa trên giá đất cụ thể.</data>
  <data key="d8">giá trị,kế hoạch</data>
  <data key="d9">chunk-c5292ad6f8216f1df76baad254080945</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738907</data>
</edge>
<edge source="Phương án bồi thường, hỗ trợ, tái định cư" target="Dự án đầu tư có sử dụng đất">
  <data key="d6">8.0</data>
  <data key="d7">Phương án bồi thường, hỗ trợ, tái định cư is used to compensate and support affected individuals and communities for Dự án đầu tư có sử dụng đất, investment projects that involve land use and development.</data>
  <data key="d8">compensation,support</data>
  <data key="d9">chunk-97d287b73c1faeec510d9b6519782d3c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740981</data>
</edge>
<edge source="Phương án bồi thường, hỗ trợ, tái định cư" target="Dự án có sử dụng đất">
  <data key="d6">9.0</data>
