<edge source="Cán bộ, chiến sĩ" target="Khu kinh tế mới">
  <data key="d6">8.0</data>
  <data key="d7">Cán bộ, chiến sĩ được giao đất để làm nhà ở tại khu kinh tế mới.</data>
