  <data key="d10">unknown_source</data>
  <data key="d11">1749740611</data>
</edge>
<edge source="Đất quốc phòng, an ninh" target="Người đang sử dụng đất">
  <data key="d6">6.0</data>
  <data key="d7">Người đang sử dụng đất có quyền sử dụng đất quốc phòng, an ninh cho đến khi có quyết định thu hồi đất của cơ quan nhà nước có thẩm quyền.</data>
  <data key="d8">quyền lợi,sử dụng đất</data>
