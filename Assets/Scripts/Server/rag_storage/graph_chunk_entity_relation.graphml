  <data key="d0">Việc trưng dụng đất</data>
  <data key="d1">event</data>
  <data key="d2">Việc trưng dụng đất là sự kiện gây ra thiệt hại cho người có đất trưng dụng và chủ sở hữu tài sản gắn liền với đất trưng dụng.</data>
