  <data key="d0">Dự án đầu tư xây dựng nhà ở</data>
  <data key="d1">event</data>
  <data key="d2">Dự án đầu tư xây dựng nhà ở là hoạt động đầu tư để xây dựng nhà ở và các công trình khác.</data>
