</edge>
<edge source="Đơn giá bồi thường thiệt hại" target="Giá thị trường">
  <data key="d6">8.0</data>
  <data key="d7">Đơn giá bồi thường thiệt hại được xác định dựa trên giá thị trường.</data>
  <data key="d8">giá trị,tài sản</data>
