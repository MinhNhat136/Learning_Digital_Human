</edge>
<edge source="Pháp luật về nhà ở" target="Khu dân cư">
  <data key="d6">6.0</data>
  <data key="d7">Pháp luật về nhà ở quy định về việc xây dựng, mua bán, cho thuê và quản lý nhà ở trong khu dân cư.</data>
  <data key="d8">quy định,quản lý</data>
