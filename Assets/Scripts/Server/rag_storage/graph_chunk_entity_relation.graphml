  <data key="d10">unknown_source</data>
  <data key="d11">1749741213</data>
</edge>
<edge source="Cá nhân" target="Khoản 2 Điều 82">
  <data key="d6">6.0</data>
  <data key="d7">Khoản 2 Điều 82 quy định về người sử dụng đất giảm hoặc không còn nhu cầu sử dụng đất và có đơn tự nguyện trả lại đất.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-7b8aee4a2f590c234177e698d97c205c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741213</data>
</edge>
<edge source="Cá nhân" target="Bồi thường">
  <data key="d6">8.0</data>
  <data key="d7">Cá nhân nhận được bồi thường khi Nhà nước thu hồi đất.</data>
  <data key="d8">hỗ trợ,nhận bồi thường</data>
  <data key="d9">chunk-1d01b62952c025dfb19d9fac59428765</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741452</data>
</edge>
<edge source="Cá nhân" target="Đất thương mại, dịch vụ">
  <data key="d6">7.0</data>
  <data key="d7">Cá nhân sử dụng đất thương mại, dịch vụ thông qua hình thức Nhà nước cho thuê đất, nhận chuyển quyền sử dụng đất, thuê đất, thuê lại đất, nhận góp vốn bằng quyền sử dụng đất của tổ chức kinh tế, cá nhân khác, người gốc Việt Nam định cư ở nước ngoài.</data>
  <data key="d8">individual activity,land use</data>
  <data key="d9">chunk-f469c3b611c15abcb5dc2df93fececa8</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780136</data>
</edge>
<edge source="Cá nhân" target="Ủy ban nhân dân cấp huyện">
  <data key="d6">15.0</data>
  <data key="d7">Ủy ban nhân dân cấp huyện quyết định giao đất, cho thuê đất, cho phép chuyển mục đích sử dụng đất đối với cá nhân.&lt;SEP&gt;Ủy ban nhân dân cấp huyện quyết định thu hồi đất đối với cá nhân.</data>
  <data key="d8">giao đất,thu hồi đất,thẩm quyền</data>
  <data key="d9">chunk-2b8e8b07ce0421ff1b0d76e82332a004&lt;SEP&gt;chunk-6b52ee0060922eaa9fdeaed10f19e48f</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780600</data>
</edge>
<edge source="Cá nhân" target="Điều 177">
  <data key="d6">6.0</data>
  <data key="d7">Điều 177 quy định về hạn mức đất nông nghiệp của cá nhân.</data>
  <data key="d8">pháp luật,quy định</data>
  <data key="d9">chunk-9fb91494ba903a6cbf58dd04a909a74f</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780246</data>
</edge>
<edge source="Cá nhân" target="Hộ gia đình">
  <data key="d6">5.0</data>
  <data key="d7">Hộ gia đình và cá nhân đều có quyền và nghĩa vụ trong việc sử dụng rừng.</data>
  <data key="d8">nghĩa vụ,quyền</data>
  <data key="d9">chunk-9cd348a6318a0d8c7443265d7d2f6de0</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780486</data>
</edge>
<edge source="Cá nhân" target="Đất bãi bồi ven sông, ven biển">
  <data key="d6">7.0</data>
  <data key="d7">Cá nhân được Nhà nước giao đất bãi bồi ven sông, ven biển để sử dụng vào mục đích nông nghiệp.</data>
  <data key="d8">nông nghiệp,sử dụng</data>
  <data key="d9">chunk-b236a9e776917e7987550623ac9f05a5</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749790295</data>
</edge>
<edge source="Cộng đồng dân cư" target="Ủy ban nhân dân cấp xã">
  <data key="d6">22.0</data>
  <data key="d7">Ủy ban nhân dân cấp xã cho thuê đất thuộc quỹ đất nông nghiệp sử dụng vào mục đích công ích của xã, phường, thị trấn.&lt;SEP&gt;Ủy ban nhân dân cấp xã có trách nhiệm xác nhận giấy tờ về đất sử dụng chung cho cộng đồng dân cư, thể hiện mối quan hệ giữa cơ quan hành chính và cộng đồng.&lt;SEP&gt;Ủy ban nhân dân cấp xã là tổ chức có thẩm quyền xác nhận về đất sử dụng chung cho cộng đồng.</data>
  <data key="d8">cho thuê đất,cộng đồng,hành chính,thẩm quyền,xác nhận</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6&lt;SEP&gt;chunk-7828861cdc70963d9f67a542d0daef55&lt;SEP&gt;chunk-6b52ee0060922eaa9fdeaed10f19e48f</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780324</data>
</edge>
<edge source="Cộng đồng dân cư" target="Đất sử dụng chung">
  <data key="d6">7.0</data>
  <data key="d7">Cộng đồng dân cư có quyền sử dụng đất chung, thể hiện mối quan hệ giữa cộng đồng và đất sử dụng chung.</data>
  <data key="d8">cộng đồng,sử dụng đất</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Hộ gia đình">
  <data key="d6">12.0</data>
  <data key="d7">Cộng đồng dân cư là tập hợp các hộ gia đình và cá nhân, có quyền và nghĩa vụ trong việc sử dụng rừng.&lt;SEP&gt;Hộ gia đình là đơn vị gia đình sống trong một khu vực địa lý nhất định, có quyền sử dụng đất chung, thể hiện mối quan hệ giữa hộ gia đình và cộng đồng.</data>
  <data key="d8">cộng đồng,quyền,tập hợp,đơn vị gia đình</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6&lt;SEP&gt;chunk-9cd348a6318a0d8c7443265d7d2f6de0</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780486</data>
</edge>
<edge source="Cộng đồng dân cư" target="Khu vực địa lý">
  <data key="d6">7.0</data>
  <data key="d7">Khu vực địa lý là vùng lãnh thổ nơi cộng đồng dân cư sống và sử dụng đất chung, thể hiện mối quan hệ giữa khu vực địa lý và cộng đồng.</data>
  <data key="d8">cộng đồng,vùng lãnh thổ</data>
  <data key="d9">chunk-7927a9a5c3f169a5b89438b2254e90b6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Cộng đồng dân cư" target="Trưởng thôn, làng, ấp, bản, bon, buôn, phum, sóc, tổ dân phố và điểm dân cư tương tự">
  <data key="d6">7.0</data>
  <data key="d7">Trưởng thôn, làng, ấp, bản, bon, buôn, phum, sóc, tổ dân phố và điểm dân cư tương tự là người đại diện cho cộng đồng dân cư, có trách nhiệm quản lý và sử dụng đất theo quy định của pháp luật.</data>
  <data key="d8">quản lý,đại diện</data>
  <data key="d9">chunk-2c36ecaddfd4da25d70ed2760df7e6f1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655940</data>
</edge>
<edge source="Cộng đồng dân cư" target="Đất">
  <data key="d6">15.0</data>
  <data key="d7">Cộng đồng dân cư có đất bị thu hồi bởi Ủy ban nhân dân cấp huyện.&lt;SEP&gt;Cộng đồng dân cư được giao quản lý đất cho mục đích công cộng.</data>
  <data key="d8">giao quản lý,quản lý đất,sở hữu,thu hồi đất</data>
  <data key="d9">chunk-df1cf85b8f6adb27f254ca957d057cb7&lt;SEP&gt;chunk-2b8e8b07ce0421ff1b0d76e82332a004</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780600</data>
</edge>
<edge source="Cộng đồng dân cư" target="Người đại diện cho cộng đồng dân cư">
  <data key="d6">9.0</data>
  <data key="d7">Người đại diện cho cộng đồng dân cư là người chịu trách nhiệm đối với đất được giao cho cộng đồng dân cư quản lý.</data>
  <data key="d8">quản lý đất,trách nhiệm</data>
  <data key="d9">chunk-df1cf85b8f6adb27f254ca957d057cb7</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655983</data>
</edge>
<edge source="Cộng đồng dân cư" target="Truyền thống văn hóa">
  <data key="d6">5.0</data>
  <data key="d7">Cộng đồng dân cư có truyền thống văn hóa và phong tục, tập quán riêng.</data>
  <data key="d8">tập quán,văn hóa</data>
  <data key="d9">chunk-c5292ad6f8216f1df76baad254080945</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738907</data>
</edge>
<edge source="Cộng đồng dân cư" target="Rừng đặc dụng">
  <data key="d6">6.0</data>
  <data key="d7">Cộng đồng dân cư được giao đất rừng đặc dụng để quản lý, sử dụng, bảo vệ, phát triển rừng.</data>
  <data key="d8">phát triển cộng đồng,quản lý rừng</data>
  <data key="d9">chunk-44e99ad9b1f1f194beca4264567e6256</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739390</data>
</edge>
<edge source="Cộng đồng dân cư" target="Luật này">
  <data key="d6">6.0</data>
  <data key="d7">Cộng đồng dân cư phải tuân thủ Luật này khi sử dụng đất nông nghiệp.</data>
  <data key="d8">sử dụng đất,tuân thủ pháp luật</data>
