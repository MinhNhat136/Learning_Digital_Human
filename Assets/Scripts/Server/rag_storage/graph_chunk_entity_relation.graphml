<edge source="Nhà nước Việt Nam dân chủ Cộng hòa" target="Chính phủ Cách mạng lâm thời Cộng hòa miền Nam Việt Nam">
  <data key="d6">8.0</data>
  <data key="d7">Cả hai đều là chính quyền đã cấp giấy tờ về quyền sử dụng đất trong quá trình thực hiện chính sách đất đai.</data>
  <data key="d8">chính quyền,chính sách đất đai</data>
  <data key="d9">chunk-84a885a6c8cdb51f06c780070d62ed55</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749655880</data>
</edge>
<edge source="Chính phủ Cách mạng lâm thời Cộng hòa miền Nam Việt Nam" target="Nhà nước Việt Nam dân chủ cộng hòa">
  <data key="d6">7.0</data>
  <data key="d7">Cả hai tổ chức đều tham gia vào quá trình thực hiện chính sách đất đai trong quá khứ.</data>
  <data key="d8">chính sách đất đai,hợp tác</data>
  <data key="d9">chunk-316e624bd53cc237e5a5b594f7028780</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740023</data>
</edge>
<edge source="Chính phủ Cách mạng lâm thời Cộng hòa miền Nam Việt Nam" target="Chính sách đất đai">
  <data key="d6">7.0</data>
  <data key="d7">Chính phủ Cách mạng lâm thời Cộng hòa miền Nam Việt Nam đã tham gia vào quá trình thực hiện chính sách đất đai.</data>
  <data key="d8">chính sách đất đai,tham gia</data>
  <data key="d9">chunk-316e624bd53cc237e5a5b594f7028780</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740023</data>
</edge>
<edge source="Nhà nước Cộng hòa xã hội chủ nghĩa Việt Nam" target="Điều 17">
  <data key="d6">8.0</data>
  <data key="d7">Điều 17 là một điều khoản trong luật đất đai, quy định về bảo đảm của Nhà nước đối với người sử dụng đất.</data>
