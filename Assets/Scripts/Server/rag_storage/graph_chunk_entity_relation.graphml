</edge>
<edge source="Chính phủ" target="Hồ sơ địa chính">
  <data key="d6">8.0</data>
  <data key="d7">Chính phủ quy định chi tiết về hồ sơ địa chính để quản lý và đăng ký đất đai.</data>
  <data key="d8">quy định pháp luật,quản lý đất đai</data>
