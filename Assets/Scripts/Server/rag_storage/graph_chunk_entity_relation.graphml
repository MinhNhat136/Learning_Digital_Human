  <data key="d5">1749739233</data>
</node>
<node id="Thu tiền thuê đất một lần cho cả thời gian thuê">
  <data key="d0">Thu tiền thuê đất một lần cho cả thời gian thuê</data>
  <data key="d1">event</data>
  <data key="d2">Thu tiền thuê đất một lần cho cả thời gian thuê là một hình thức thu tiền thuê đất mà tổ chức kinh tế, cá nhân, người gốc Việt Nam định cư ở nước ngoài, tổ chức kinh tế có vốn đầu tư nước ngoài phải trả cho Nhà nước một lần cho cả thời gian thuê.</data>
  <data key="d3">chunk-8d51255821bf04c33a54f5cb79468a77</data>
  <data key="d4">unknown_source</data>
