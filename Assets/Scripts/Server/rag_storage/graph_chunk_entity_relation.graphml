<edge source="Người sử dụng đất" target="Bồi thường, hỗ trợ, tái định cư">
  <data key="d6">8.0</data>
  <data key="d7">Bồi thường, hỗ trợ, tái định cư là các biện pháp được thực hiện để hỗ trợ người sử dụng đất khi Nhà nước thu hồi đất.</data>
  <data key="d8">hỗ trợ,tái định cư</data>
