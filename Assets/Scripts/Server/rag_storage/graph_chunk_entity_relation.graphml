  <data key="d11">1749739272</data>
</edge>
<edge source="Điều 34" target="Điều 31">
  <data key="d6">8.0</data>
  <data key="d7">Điều 34 quy định về quyền và nghĩa vụ của tổ chức kinh tế, đơn vị sự nghiệp công lập và tổ chức tôn giáo, tham chiếu đến Điều 31 về quyền và nghĩa vụ chung.</data>
  <data key="d8">quy định,quyền và nghĩa vụ</data>
