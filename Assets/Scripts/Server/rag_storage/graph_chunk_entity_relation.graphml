<node id="Khu chung cư">
  <data key="d0">Khu chung cư</data>
  <data key="d1">geo</data>
  <data key="d2">Khu chung cư là khu vực được quy hoạch để xây dựng nhà chung cư và các công trình phục vụ cộng đồng.</data>
