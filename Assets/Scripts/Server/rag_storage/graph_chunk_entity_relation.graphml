<edge source="Người có đất trưng dụng" target="Chủ sở hữu tài sản gắn liền với đất trưng dụng">
  <data key="d6">7.0</data>
  <data key="d7">Cả người có đất trưng dụng và chủ sở hữu tài sản gắn liền với đất trưng dụng đều nhận được bồi thường thiệt hại.</data>
  <data key="d8">bồi thường thiệt hại,hỗ trợ tài chính</data>
  <data key="d9">chunk-8fc4053b60ef6cd0c87079f3131b0b96</data>
