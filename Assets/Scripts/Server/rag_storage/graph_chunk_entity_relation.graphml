</edge>
<edge source="Đất" target="Dự án đầu tư sản xuất nông nghiệp, lâm nghiệp, nuôi trồng thủy sản, làm muối">
  <data key="d6">8.0</data>
  <data key="d7">Dự án đầu tư sản xuất nông nghiệp, lâm nghiệp, nuôi trồng thủy sản, làm muối được thực hiện trên đất thuê.</data>
