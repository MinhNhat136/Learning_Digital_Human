<edge source="Người sử dụng đất" target="Hợp đồng góp vốn">
  <data key="d6">6.0</data>
  <data key="d7">Hợp đồng góp vốn là một loại hợp đồng giữa người sử dụng đất và người góp vốn.</data>
  <data key="d8">góp vốn,hợp đồng</data>
