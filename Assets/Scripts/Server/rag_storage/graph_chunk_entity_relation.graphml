  <data key="d11">1749739796</data>
</edge>
<edge source="Ủy Ban Nhân Dân" target="Chính Phủ">
  <data key="d6">8.0</data>
  <data key="d7">Chính Phủ quy định trình tự, thủ tục cho Ủy Ban Nhân Dân trong việc công nhận kết quả hòa giải thành về tranh chấp đất đai.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-441a092bb7fe3b39b917ede05c2b268f</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780819</data>
</edge>
<edge source="Nông, Lâm Trường Quốc Doanh" target="Tòa Án">
  <data key="d6">6.0</data>
  <data key="d7">Nông, Lâm Trường Quốc Doanh may be involved in disputes related to land use that are resolved by Tòa Án.</data>
