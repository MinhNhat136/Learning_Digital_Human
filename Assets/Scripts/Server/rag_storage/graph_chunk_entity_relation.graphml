  <data key="d6">8.0</data>
  <data key="d7">Ủy ban nhân dân cấp xã and Ủy ban Mặt trận Tổ quốc Việt Nam work together to implement tasks related to land acquisition and compensation.</data>
  <data key="d8">cooperation,land acquisition</data>
  <data key="d9">chunk-d3c26e6c9ef2ffca3cc40a0524d879e6</data>
  <data key="d10">unknown_source</data>
