  <data key="d11">1749740379</data>
</edge>
<edge source="Quỹ đất nông nghiệp sử dụng vào mục đích công ích" target="Công trình văn hóa, thể dục thể thao, vui chơi, giải trí công cộng">
  <data key="d6">6.0</data>
  <data key="d7">Công trình văn hóa, thể dục thể thao, vui chơi, giải trí công cộng được tổ chức trên quỹ đất nông nghiệp sử dụng vào mục đích công ích.</data>
  <data key="d8">sử dụng đất,tổ chức hoạt động</data>
