<edge source="Tranh chấp đất đai" target="Hòa giải">
  <data key="d6">8.0</data>
  <data key="d7">Hòa giải là quá trình giải quyết tranh chấp đất đai thông qua thương lượng và thỏa thuận.</data>
  <data key="d8">giải quyết,thương lượng</data>
  <data key="d9">chunk-dc2acc0bb5d03772f1a84d43cba7242d</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780395</data>
</edge>
<edge source="Tranh chấp đất đai" target="Thương mại">
  <data key="d6">9.0</data>
  <data key="d7">Thương mại là lĩnh vực hoạt động liên quan đến mua bán, trao đổi hàng hóa và dịch vụ, và có thể dẫn đến tranh chấp đất đai.</data>
  <data key="d8">lĩnh vực hoạt động,tranh chấp</data>
  <data key="d9">chunk-304848445351513cab898b1745da50f1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749816244</data>
</edge>
<edge source="Nhà ở" target="Tổ chức tín dụng">
  <data key="d6">6.0</data>
  <data key="d7">Tổ chức tín dụng provides mortgage services for Nhà ở owned by people of Vietnamese origin living abroad in Vietnam.</data>
  <data key="d8">financial services,mortgage</data>
  <data key="d9">chunk-d6334611afd4608fc8ea538c2f2a37d9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738750</data>
</edge>
<edge source="Nhà ở" target="Nhà chung cư">
  <data key="d6">8.0</data>
  <data key="d7">Nhà ở và nhà chung cư có mối quan hệ trong việc cung cấp nơi ở cho con người.</data>
  <data key="d8">nhà,nơi ở</data>
  <data key="d9">chunk-9a88f9e82e87dae6ff3459ac963afcac</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739320</data>
</edge>
<edge source="Nhà ở" target="Công trình xây dựng">
  <data key="d6">7.0</data>
  <data key="d7">Nhà ở và công trình xây dựng là loại tài sản bị tháo dỡ hoặc phá dỡ khi Nhà nước thu hồi đất.</data>
  <data key="d8">thu hồi đất,tài sản</data>
  <data key="d9">chunk-a71913a9d910f20f81f36497d5015ca1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741198</data>
</edge>
<edge source="Người nhận thừa kế" target="Tổ chức đăng ký đất đai">
  <data key="d6">6.0</data>
  <data key="d7">Tổ chức đăng ký đất đai provides services to Người nhận thừa kế, including registration and management of land use information.</data>
  <data key="d8">inheritance,land registration</data>
  <data key="d9">chunk-d6334611afd4608fc8ea538c2f2a37d9</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738750</data>
</edge>
<edge source="Tổ chức đăng ký đất đai" target="Tổ chức dịch vụ công về đất đai">
  <data key="d6">9.0</data>
  <data key="d7">Tổ chức đăng ký đất đai là một phần của tổ chức dịch vụ công về đất đai.</data>
  <data key="d8">dịch vụ công,tổ chức</data>
  <data key="d9">chunk-a32ac176857641a621356be260e9488c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740869</data>
</edge>
<edge source="Tổ chức đăng ký đất đai" target="Chi nhánh của tổ chức đăng ký đất đai">
  <data key="d6">9.0</data>
  <data key="d7">Tổ chức đăng ký đất đai và Chi nhánh của tổ chức đăng ký đất đai phối hợp để đăng ký và cập nhật thông tin về đất đai.</data>
  <data key="d8">phối hợp,đăng ký</data>
  <data key="d9">chunk-c7276e69c5b93440eaab27a9033847c5</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740881</data>
</edge>
<edge source="Tổ chức đăng ký đất đai" target="Cơ sở dữ liệu đất đai">
  <data key="d6">9.0</data>
  <data key="d7">Tổ chức đăng ký đất đai manages and updates Cơ sở dữ liệu đất đai.</data>
  <data key="d8">data management,land registration</data>
  <data key="d9">chunk-9ca0666d9ee9dc9838455e6bd349f7f2</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741039</data>
</edge>
<edge source="Điều 29" target="Điều 133">
  <data key="d6">7.0</data>
  <data key="d7">Điều 29 và Điều 133 đều là các điều khoản trong luật liên quan đến quyền đối với thửa đất liền kề.</data>
  <data key="d8">liên quan,pháp luật</data>
  <data key="d9">chunk-4db210607f57cbc18f02a3a9e3b3e494</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
<edge source="Pháp luật về dân sự" target="Quyền đối với thửa đất liền kề">
  <data key="d6">9.0</data>
  <data key="d7">Pháp luật về dân sự quy định về các quan hệ dân sự liên quan đến quyền đối với thửa đất liền kề.</data>
  <data key="d8">pháp luật,quy định</data>
  <data key="d9">chunk-4db210607f57cbc18f02a3a9e3b3e494</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
<edge source="Pháp luật về dân sự" target="Cá nhân sử dụng đất thuê">
  <data key="d6">9.0</data>
  <data key="d7">Pháp luật về dân sự governs the rights and obligations of Cá nhân sử dụng đất thuê in land rental transactions.</data>
  <data key="d8">civil law,individual rights</data>
  <data key="d9">chunk-b687af538208e11568b0de93e461ec7c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739506</data>
</edge>
<edge source="Pháp luật về dân sự" target="Khoản 3 Điều này">
  <data key="d6">9.0</data>
  <data key="d7">Khoản 3 Điều này is a specific clause within Pháp luật về dân sự that regulates land use and rental transactions.</data>
  <data key="d8">legal clause,regulation</data>
  <data key="d9">chunk-b687af538208e11568b0de93e461ec7c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739506</data>
</edge>
<edge source="Pháp luật về dân sự" target="Quy định của pháp luật">
  <data key="d6">9.0</data>
  <data key="d7">Quy định của pháp luật includes Pháp luật về dân sự, which governs relationships and transactions between individuals and organizations.</data>
  <data key="d8">civil law,legal regulation</data>
  <data key="d9">chunk-b687af538208e11568b0de93e461ec7c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739506</data>
</edge>
<edge source="Thửa đất liền kề" target="Lối đi">
  <data key="d6">6.0</data>
  <data key="d7">Thửa đất liền kề có thể có lối đi.</data>
  <data key="d8">quyền sử dụng,địa lý</data>
  <data key="d9">chunk-4db210607f57cbc18f02a3a9e3b3e494</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
