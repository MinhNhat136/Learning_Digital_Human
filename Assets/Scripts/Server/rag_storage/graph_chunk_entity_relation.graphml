<node id="Thời hạn sử dụng đất">
  <data key="d0">Thời hạn sử dụng đất</data>
  <data key="d1">category</data>
  <data key="d2">Thời hạn sử dụng đất là khoảng thời gian mà người sử dụng đất được phép sử dụng đất.&lt;SEP&gt;Thời hạn sử dụng đất là khoảng thời gian được quy định cho việc sử dụng đất.</data>
  <data key="d3">chunk-723009b6f3944ab9b1b5c81c9c0d27bf&lt;SEP&gt;chunk-3d7430474b8c0567cb4969f22ad7777e</data>
