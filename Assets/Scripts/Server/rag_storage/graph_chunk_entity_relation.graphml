  <data key="d0">Thửa đất liền kề</data>
  <data key="d1">geo</data>
  <data key="d2">Thửa đất liền kề là một khu vực đất cụ thể được đề cập trong luật.</data>
  <data key="d3">chunk-4db210607f57cbc18f02a3a9e3b3e494</data>
