</edge>
<edge source="Thời hạn hoàn trả đất" target="Kế hoạch tái định cư">
  <data key="d6">7.0</data>
  <data key="d7">Thời hạn hoàn trả đất và kế hoạch tái định cư có mối quan hệ với nhau trong việc hỗ trợ người có đất trưng dụng và chủ sở hữu tài sản gắn liền với đất trưng dụng.</data>
  <data key="d8">hoàn trả đất,hỗ trợ tái định cư</data>
