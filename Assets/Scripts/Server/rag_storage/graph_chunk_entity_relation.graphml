<edge source="Thu hồi đất" target="Dự án phát triển kinh tế - xã hội">
  <data key="d6">9.0</data>
  <data key="d7">Thu hồi đất là việc lấy lại đất từ người sử dụng để thực hiện dự án phát triển kinh tế - xã hội.</data>
  <data key="d8">dự án,thu hồi đất</data>
