  <data key="d11">1749780577</data>
</edge>
<edge source="Người sử dụng đất" target="Hợp đồng thuê đất">
  <data key="d6">6.0</data>
  <data key="d7">Hợp đồng thuê đất là một loại hợp đồng giữa người sử dụng đất và người thuê đất.</data>
  <data key="d8">hợp đồng,thuê đất</data>
