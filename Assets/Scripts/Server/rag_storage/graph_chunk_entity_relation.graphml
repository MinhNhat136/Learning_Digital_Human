  <data key="d11">1749740613</data>
</edge>
<edge source="Đất quốc phòng, an ninh" target="Đơn vị quân đội">
  <data key="d6">7.0</data>
  <data key="d7">Đơn vị quân đội uses đất quốc phòng, an ninh for labor production and economic construction.</data>
  <data key="d8">economic activity,land use</data>
