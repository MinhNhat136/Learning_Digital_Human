  <data key="d6">6.0</data>
  <data key="d7">Hợp đồng hợp tác kinh doanh là một loại hợp đồng giữa người sử dụng đất và người hợp tác kinh doanh.</data>
  <data key="d8">hợp tác kinh doanh,hợp đồng</data>
