  <data key="d11">1749740798</data>
</edge>
<edge source="Đất quốc phòng, an ninh" target="Bộ Công an">
  <data key="d6">8.0</data>
  <data key="d7">Bộ Công an có trách nhiệm quản lý và sử dụng đất quốc phòng, an ninh.</data>
