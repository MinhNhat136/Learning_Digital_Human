  <data key="d1">geo</data>
  <data key="d2">Huyện is a district administrative unit that has its own land use plans.&lt;SEP&gt;Huyện là cấp quản lý đất đai dưới tỉnh.</data>
  <data key="d3">chunk-9e1a00a1969dce8daab43a2f32c7610e&lt;SEP&gt;chunk-a32ac176857641a621356be260e9488c</data>
