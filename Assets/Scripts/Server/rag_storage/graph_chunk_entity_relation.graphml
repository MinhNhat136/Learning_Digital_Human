  <data key="d0">Đất sinh hoạt cộng đồng</data>
  <data key="d1">category</data>
  <data key="d2">Đất sinh hoạt cộng đồng là loại đất được sử dụng cho mục đích sinh hoạt của cộng đồng đồng bào dân tộc thiểu số.</data>
  <data key="d3">chunk-c347cd62ee764c843f0d4fe42e7af593</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1749739745</data>
</node>
<node id="Hộ nghèo">
