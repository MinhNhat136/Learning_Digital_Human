</edge>
<edge source="Đất" target="Tài sản gắn liền với đất">
  <data key="d6">7.0</data>
  <data key="d7">Tài sản gắn liền với đất là tài sản được xây dựng, trồng hoặc tạo ra trên đất, trong khi đất là tài nguyên thiên nhiên.</data>
  <data key="d8">tài sản,đất đai</data>
  <data key="d9">chunk-cb8f628ae8c6ae843b68f3a8152eb1a6</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739491</data>
</edge>
<edge source="Đất" target="Tài Sản">
  <data key="d6">5.0</data>
  <data key="d7">Đất là một loại tài sản được sở hữu bởi cá nhân, tổ chức.</data>
  <data key="d8">tài sản,đất đai</data>
  <data key="d9">chunk-b987053653b257cd57b747bc876c5d7b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739506</data>
</edge>
<edge source="Đất" target="Cá nhân sử dụng đất thuê">
  <data key="d6">8.0</data>
  <data key="d7">Đất is the land that Cá nhân sử dụng đất thuê rents from others, with associated rights and obligations.</data>
  <data key="d8">land,rental</data>
  <data key="d9">chunk-b687af538208e11568b0de93e461ec7c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739506</data>
</edge>
<edge source="Đất" target="Tổ chức, cá nhân cho thuê đất">
  <data key="d6">7.0</data>
  <data key="d7">Tổ chức, cá nhân cho thuê đất owns or manages Đất, which is rented to Cá nhân sử dụng đất thuê.</data>
  <data key="d8">land ownership,rental</data>
  <data key="d9">chunk-b687af538208e11568b0de93e461ec7c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739506</data>
</edge>
<edge source="Đất" target="Tổ chức tôn giáo trực thuộc">
  <data key="d6">14.0</data>
  <data key="d7">Tổ chức tôn giáo trực thuộc có đất bị thu hồi bởi Ủy ban nhân dân cấp tỉnh.&lt;SEP&gt;Tổ chức tôn giáo trực thuộc được Nhà nước giao đất không thu tiền sử dụng đất, có quyền và nghĩa vụ chung quy định tại Điều 26 và Điều 31 của Luật này.</data>
  <data key="d8">quyền hạn,sở hữu,sử dụng đất,thu hồi đất</data>
  <data key="d9">chunk-2b8e8b07ce0421ff1b0d76e82332a004&lt;SEP&gt;chunk-8f8fe3943c4c045bc368aff2f1c10c45</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749780600</data>
</edge>
<edge source="Đất" target="Tài sản">
  <data key="d6">6.0</data>
  <data key="d7">Đất bị thu hồi dẫn đến việc di chuyển tài sản.</data>
