  <data key="d10">unknown_source</data>
  <data key="d11">1749739233</data>
</edge>
<edge source="Điều 118" target="Điều 176">
  <data key="d6">8.0</data>
  <data key="d7">Điều 118 và Điều 176 là các điều khoản trong Luật đất đai quy định về việc giao đất không thu tiền sử dụng đất và hạn mức giao đất nông nghiệp.</data>
  <data key="d8">giao đất,pháp luật</data>
  <data key="d9">chunk-e95fa72656913e44897b9372de39ee00</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749741351</data>
</edge>
<edge source="Điều 124" target="Điều 121">
  <data key="d6">9.0</data>
  <data key="d7">Điều 121 và Điều 124 là các điều khoản trong Luật đất đai quy định về việc chuyển mục đích sử dụng đất và thực hiện chuyển mục đích sử dụng đất.</data>
  <data key="d8">quy định pháp luật,quản lý đất đai</data>
  <data key="d9">chunk-2f52166f5e54b33b63f9f67ceb47dc6b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739554</data>
</edge>
<edge source="Khu công nghệ cao" target="Khu công nghiệp">
  <data key="d6">7.0</data>
  <data key="d7">Khu công nghiệp và khu công nghệ cao đều là khu vực được quy hoạch để phát triển, nơi tổ chức kinh tế, đơn vị sự nghiệp công lập và tổ chức tôn giáo được Nhà nước cho thuê đất thu tiền thuê đất hằng năm.</data>
  <data key="d8">khu vực,phát triển</data>
  <data key="d9">chunk-07d5c9c2eb758b3f713bf3c91f86f6fb</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739272</data>
</edge>
<edge source="Ban quản lý rừng phòng hộ" target="Rừng phòng hộ">
  <data key="d6">18.0</data>
  <data key="d7">Ban quản lý rừng phòng hộ quản lý và bảo vệ rừng phòng hộ.&lt;SEP&gt;Ban quản lý rừng phòng hộ được giao đất rừng phòng hộ để quản lý và bảo vệ.</data>
  <data key="d8">bảo vệ rừng,quản lý rừng</data>
  <data key="d9">chunk-ea5f0106b317e7328a5942e51b49760c&lt;SEP&gt;chunk-060b8fe077aa42c32e508c67940a02e1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740388</data>
</edge>
<edge source="Đơn vị thuộc lực lượng vũ trang nhân dân" target="Đất rừng sản xuất">
  <data key="d6">7.0</data>
  <data key="d7">Đơn vị thuộc lực lượng vũ trang nhân dân được giao đất rừng sản xuất để bảo vệ và phát triển rừng.</data>
  <data key="d8">bảo vệ rừng,phát triển rừng</data>
  <data key="d9">chunk-060b8fe077aa42c32e508c67940a02e1</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740388</data>
</edge>
<edge source="Cá nhân cư trú hợp pháp trên địa bàn cấp xã nơi có rừng phòng hộ" target="Rừng phòng hộ">
  <data key="d6">7.0</data>
  <data key="d7">Cá nhân cư trú hợp pháp trên địa bàn cấp xã nơi có rừng phòng hộ được giao đất rừng phòng hộ để sử dụng và bảo vệ.</data>
  <data key="d8">bảo vệ rừng,sử dụng rừng</data>
  <data key="d9">chunk-ea5f0106b317e7328a5942e51b49760c</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749739258</data>
</edge>
<edge source="Cộng đồng dân cư trên địa bàn cấp xã nơi có rừng phòng hộ" target="Rừng phòng hộ">
  <data key="d6">7.0</data>
  <data key="d7">Cộng đồng dân cư trên địa bàn cấp xã nơi có rừng phòng hộ được giao đất rừng phòng hộ để sử dụng và bảo vệ.</data>
  <data key="d8">bảo vệ rừng,sử dụng rừng</data>
  <data key="d9">chunk-ea5f0106b317e7328a5942e51b49760c</data>
