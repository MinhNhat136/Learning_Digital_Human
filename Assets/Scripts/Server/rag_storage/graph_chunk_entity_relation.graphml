<edge source="Nhà Đầu Tư" target="Khu Nuôi Trồng">
  <data key="d6">7.0</data>
  <data key="d7">Investors lease land from the government to develop infrastructure for concentrated farming and production areas.</data>
  <data key="d8">infrastructure development,investment</data>
