  <data key="d1">category</data>
  <data key="d2">Tài sản gắn liền với đất trưng dụng là tài sản được xây dựng hoặc gắn liền với đất bị trưng dụng.</data>
  <data key="d3">chunk-8fc4053b60ef6cd0c87079f3131b0b96</data>
