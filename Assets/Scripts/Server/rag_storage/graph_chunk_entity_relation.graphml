  <data key="d5">1749780282</data>
</node>
<node id="Đất trồng cây lâu năm">
  <data key="d0">Đất trồng cây lâu năm</data>
  <data key="d1">category</data>
  <data key="d2">Đất trồng cây lâu năm là loại đất nông nghiệp được giao cho cá nhân trực tiếp sản xuất nông nghiệp với thời hạn 50 năm.&lt;SEP&gt;Đất trồng cây lâu năm là loại đất nông nghiệp, được sử dụng để trồng cây lâu năm.&lt;SEP&gt;Đất trồng cây lâu năm refers to a type of land used for growing perennial crops.&lt;SEP&gt;Đất trồng cây lâu năm là loại đất được sử dụng để trồng cây lâu năm.</data>
  <data key="d3">chunk-3b9cd51d144c28bf97ce93d074263e35&lt;SEP&gt;chunk-b9745fb3c299c9cd92793005e3af002f&lt;SEP&gt;chunk-fd7fc990c419934065b5442e773f1126&lt;SEP&gt;chunk-589f414037593daa74c6516060819a0f</data>
