  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
<edge source="Thửa đất liền kề" target="Đường dây tải điện, thông tin liên lạc">
  <data key="d6">6.0</data>
  <data key="d7">Thửa đất liền kề có thể có đường dây tải điện, thông tin liên lạc.</data>
  <data key="d8">quyền sử dụng,địa lý</data>
  <data key="d9">chunk-4db210607f57cbc18f02a3a9e3b3e494</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
<edge source="Khiếu nại" target="Tố tụng hành chính">
  <data key="d6">10.0</data>
  <data key="d7">Tố tụng hành chính là quá trình giải quyết khiếu nại liên quan đến quyết định hành chính hoặc hành vi hành chính.</data>
  <data key="d8">giải quyết,tranh chấp</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Khiếu nại" target="Pháp luật về khiếu nại">
  <data key="d6">7.0</data>
  <data key="d7">Pháp luật về khiếu nại quy định và hướng dẫn việc giải quyết khiếu nại.</data>
  <data key="d8">hướng dẫn,quy định</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Tố tụng hành chính" target="Pháp luật về tố tụng hành chính">
  <data key="d6">8.0</data>
  <data key="d7">Pháp luật về tố tụng hành chính quy định và hướng dẫn việc giải quyết tranh chấp hành chính.</data>
  <data key="d8">hướng dẫn,quy định</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Quyết định hành chính" target="Cơ quan hành chính">
  <data key="d6">9.0</data>
  <data key="d7">Quyết định hành chính được đưa ra bởi cơ quan hành chính.</data>
  <data key="d8">quyết định,thẩm quyền</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Hành vi hành chính" target="Cơ quan hành chính">
  <data key="d6">9.0</data>
  <data key="d7">Hành vi hành chính được thực hiện bởi cơ quan hành chính.</data>
  <data key="d8">hành động,thẩm quyền</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Cơ quan hành chính" target="Điều 237">
  <data key="d6">9.0</data>
  <data key="d7">Cơ quan hành chính có thẩm quyền giải quyết khiếu nại, khởi kiện theo quy định tại Điều 237.</data>
  <data key="d8">giải quyết,thẩm quyền</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Hồ sơ, tài liệu" target="Thu thập, bảo quản, sử dụng và lưu trữ">
  <data key="d6">8.0</data>
  <data key="d7">Hồ sơ, tài liệu được thu thập, bảo quản, sử dụng và lưu trữ trong quá trình giải quyết khiếu nại và tố tụng hành chính.</data>
  <data key="d8">bảo vệ,quản lý</data>
  <data key="d9">chunk-082eb0bf4654a4b649f38f6a94be666b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738777</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Tổ chức">
  <data key="d6">7.0</data>
  <data key="d7">Tổ chức tham gia đấu giá quyền sử dụng đất để được giao đất, cho thuê đất.</data>
  <data key="d8">quyền lợi,tham gia</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Luật Đất đai">
  <data key="d6">9.0</data>
  <data key="d7">Luật Đất đai quy định về việc đấu giá quyền sử dụng đất.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Quy hoạch chi tiết">
  <data key="d6">8.0</data>
  <data key="d7">Quy hoạch chi tiết quy định về việc quy hoạch, kế hoạch sử dụng đất, bao gồm cả đấu giá quyền sử dụng đất.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Phương án đấu giá quyền sử dụng đất">
  <data key="d6">9.0</data>
  <data key="d7">Phương án đấu giá quyền sử dụng đất là kế hoạch cụ thể để tổ chức đấu giá quyền sử dụng đất.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Phương án thu hồi, bồi thường, hỗ trợ, tái định cư">
  <data key="d6">8.0</data>
  <data key="d7">Phương án thu hồi, bồi thường, hỗ trợ, tái định cư là kế hoạch cụ thể để thực hiện việc thu hồi, bồi thường, hỗ trợ, tái định cư trước khi đấu giá quyền sử dụng đất.</data>
  <data key="d8">quy định,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Cổng thông tin đấu giá quyền sử dụng đất quốc gia">
  <data key="d6">8.0</data>
  <data key="d7">Cổng thông tin đấu giá quyền sử dụng đất quốc gia cung cấp thông tin về đấu giá quyền sử dụng đất.</data>
  <data key="d8">cung cấp thông tin,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Cổng thông tin điện tử của Ủy ban nhân dân cấp tỉnh">
  <data key="d6">8.0</data>
  <data key="d7">Cổng thông tin điện tử của Ủy ban nhân dân cấp tỉnh cung cấp thông tin về việc sử dụng đất, bao gồm cả đấu giá quyền sử dụng đất.</data>
  <data key="d8">cung cấp thông tin,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Cổng thông tin điện tử của Ủy ban nhân dân cấp huyện">
  <data key="d6">8.0</data>
  <data key="d7">Cổng thông tin điện tử của Ủy ban nhân dân cấp huyện cung cấp thông tin về việc sử dụng đất, bao gồm cả đấu giá quyền sử dụng đất.</data>
  <data key="d8">cung cấp thông tin,quản lý</data>
  <data key="d9">chunk-629e5c6e37c46d31e67eb3f34ddfbc8b</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738781</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Người trúng đấu giá quyền sử dụng đất">
  <data key="d6">10.0</data>
  <data key="d7">Người trúng đấu giá quyền sử dụng đất tham gia và thắng cuộc đấu giá quyền sử dụng đất.</data>
  <data key="d8">tham gia,thắng cuộc</data>
  <data key="d9">chunk-c7276e69c5b93440eaab27a9033847c5</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749740881</data>
</edge>
<edge source="Đấu giá quyền sử dụng đất" target="Đấu thầu lựa chọn nhà đầu tư">
  <data key="d6">15.0</data>
  <data key="d7">Đấu giá quyền sử dụng đất and Đấu thầu lựa chọn nhà đầu tư are both processes related to selecting investors and allocating land use rights.&lt;SEP&gt;Đấu giá quyền sử dụng đất và đấu thầu lựa chọn nhà đầu tư là hai quá trình khác nhau nhưng đều liên quan đến việc lựa chọn nhà đầu tư thực hiện dự án có sử dụng đất.</data>
  <data key="d8">dự án,investment,land use,lựa chọn nhà đầu tư</data>
  <data key="d9">chunk-72c732048d00311d8a438200bac09c11&lt;SEP&gt;chunk-315e6159cb2573d8ce5fae8d943c3158</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749790295</data>
