  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
<edge source="Thửa đất liền kề" target="Tưới nước, tiêu nước">
  <data key="d6">6.0</data>
  <data key="d7">Thửa đất liền kề có thể có tưới nước, tiêu nước.</data>
  <data key="d8">quyền sử dụng,địa lý</data>
  <data key="d9">chunk-4db210607f57cbc18f02a3a9e3b3e494</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1749738757</data>
</edge>
<edge source="Thửa đất liền kề" target="Cấp khí ga">
  <data key="d6">6.0</data>
  <data key="d7">Thửa đất liền kề có thể có cấp khí ga.</data>
  <data key="d8">quyền sử dụng,địa lý</data>
