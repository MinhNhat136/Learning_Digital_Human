  <data key="d11">1749741198</data>
</edge>
<edge source="Công trình xây dựng khác" target="Giấy phép xây dựng">
  <data key="d6">7.0</data>
  <data key="d7">Giấy phép xây dựng cho phép xây dựng công trình trên đất.</data>
  <data key="d8">pháp luật,xây dựng</data>
